---
import "../styles/global.css";
import "../styles/tool.css";
import BrandMark from "../components/BrandMark.astro";
import { SITE, NAV } from "../config";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · Coall` : "Coall · Parlez, Coall dessine";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <header class="nav" data-nav>
      <div class="wrap nav-inner">
        <a href="/" class="brand" aria-label="Coall, accueil">
          <BrandMark size={22} />
          <span>Coall</span>
        </a>
        <nav class="nav-links" aria-label="Navigation principale">
          {NAV.map((l) => (
            <a href={l.href} class:list={[{ active: isActive(l.href) }]}>{l.label}</a>
          ))}
        </nav>
        <div class="nav-cta">
          <a href="/contact" class="nav-plain">Contact</a>
          <a href="/liste-d-attente" class="btn btn-primary btn-sm">Liste d'attente</a>
          <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" data-burger>
            <span></span><span></span>
          </button>
        </div>
      </div>
      <div class="mobile-menu" data-menu hidden>
        <nav class="wrap" aria-label="Navigation mobile">
          {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/contact">Contact</a>
          <a href="/liste-d-attente" class="btn btn-primary">Rejoindre la liste d'attente</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <a href="/" class="brand"><BrandMark size={22} /><span>Coall</span></a>
            <p class="dim">« Co » pour coopérer, « all » pour tous. Ensemble, on entend <em>call</em>.</p>
          </div>
          <div class="footer-cols">
            <div>
              <p class="label">Produit</p>
              <a href="/fonctionnalites">Fonctionnalités</a>
              <a href="/cas-d-usage">Cas d'usage</a>
              <a href="/tarifs">Tarifs</a>
              <a href="/liste-d-attente">Liste d'attente</a>
            </div>
            <div>
              <p class="label">Documentation</p>
              <a href="/docs/prise-en-main">Prise en main</a>
              <a href="/docs/appel-et-ecoute">Appel et écoute</a>
              <a href="/docs/plugin-figma">Plugin Figma</a>
              <a href="/docs/raccourcis">Raccourcis</a>
              <a href="/docs/nouveautes">Nouveautés</a>
            </div>
            <div>
              <p class="label">Coall</p>
              <a href="/contact">Contact</a>
              <a href="/confidentialite">Confidentialité</a>
              <a href="/mentions-legales">Mentions légales</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span class="dim">© {new Date().getFullYear()} Coall</span>
          <span class="dim">Conception collaborative, à voix haute.</span>
        </div>
      </div>
    </footer>

    <script>
      // Navigation : fond au défilement, menu mobile.
      const nav = document.querySelector("[data-nav]");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
      const menu = document.querySelector<HTMLElement>("[data-menu]");
      burger?.addEventListener("click", () => {
        const open = burger.getAttribute("aria-expanded") === "true";
        burger.setAttribute("aria-expanded", String(!open));
        burger.setAttribute("aria-label", open ? "Ouvrir le menu" : "Fermer le menu");
        if (menu) menu.hidden = open;
        nav?.classList.toggle("menu-open", !open);
      });

      // Apparition des blocs au défilement.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>

    <style>
      .skip {
        position: absolute;
        left: 12px;
        top: -80px;
        z-index: 100;
        padding: 8px 12px;
        border-radius: 8px;
        background: var(--ink);
        color: var(--bg);
      }
      .skip:focus {
        top: 12px;
      }
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid transparent;
        transition:
          background 0.25s,
          border-color 0.25s;
      }
      .nav.scrolled,
      .nav.menu-open {
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(14px) saturate(1.4);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        border-bottom-color: var(--line);
      }
      .nav-inner {
        height: 64px;
        display: flex;
        align-items: center;
        gap: 32px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-weight: 590;
        font-size: 16px;
        letter-spacing: -0.015em;
      }
      .nav-links {
        display: flex;
        gap: 4px;
        flex: 1;
      }
      .nav-links a,
      .nav-plain {
        font-size: 14px;
        font-weight: 450;
        color: var(--muted);
        padding: 6px 10px;
        transition:
          color 0.15s,
          background 0.15s;
      }
      .nav-links a:hover,
      .nav-plain:hover,
      .nav-links a.active {
        color: var(--ink);
      }

      .nav-cta {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .burger {
        display: none;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line-2);
        background: transparent;
        border-radius: 8px;
        cursor: pointer;
        position: relative;
      }
      .burger span {
        position: absolute;
        left: 12px;
        right: 12px;
        height: 1.5px;
        background: var(--ink);
        transition: transform 0.2s;
      }
      .burger span:first-child {
        top: 16px;
      }
      .burger span:last-child {
        top: 22px;
      }
      .burger[aria-expanded="true"] span:first-child {
        transform: translateY(3px) rotate(45deg);
      }
      .burger[aria-expanded="true"] span:last-child {
        transform: translateY(-3px) rotate(-45deg);
      }
      .mobile-menu nav {
        display: grid;
        gap: 4px;
        padding-top: 8px;
        padding-bottom: 20px;
      }
      .mobile-menu a:not(.btn) {
        padding: 12px 0;
        font-size: 18px;
        font-weight: 550;
        border-bottom: 1px solid var(--line);
      }
      .mobile-menu .btn {
        margin-top: 16px;
      }
      @media (max-width: 860px) {
        .nav-links,
        .nav-plain {
          display: none;
        }
        .nav-inner {
          justify-content: space-between;
        }
        .burger {
          display: block;
        }
      }
      @media (max-width: 420px) {
        .nav-cta .btn {
          display: none;
        }
      }

      .footer {
        border-top: 1px solid var(--line);
        padding: 64px 0 32px;
        background: var(--bg);
      }
      .footer-top {
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 48px;
      }
      .footer-brand p {
        margin: 16px 0 0;
        font-size: 14px;
        max-width: 320px;
      }
      .footer-cols {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      .footer-cols div {
        display: grid;
        gap: 10px;
        align-content: start;
      }
      .footer-cols .label {
        margin: 0 0 6px;
        font-size: 13px;
        color: var(--ink);
      }
      .footer-cols a {
        font-size: 14px;
        color: var(--muted);
      }
      .footer-cols a:hover {
        color: var(--ink);
      }
      .footer-bottom {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 13px;
      }
      @media (max-width: 760px) {
        .footer-top {
          grid-template-columns: 1fr;
        }
        .footer-cols {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </body>
</html>
