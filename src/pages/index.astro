---
import Base from "../layouts/Base.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Flow from "../components/Flow.astro";
import Waitlist from "../components/Waitlist.astro";
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero>
    <div class="hero-bg dotgrid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <!-- Curseurs d'ambiance (le vôtre suit la souris) -->
    <div class="cursor amb amb-1" aria-hidden="true">
      <svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L6.9 15z" fill="#e255a1" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></svg>
      <span class="name" style="background:#e255a1">Alice</span>
    </div>
    <div class="cursor amb amb-2" aria-hidden="true">
      <svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L6.9 15z" fill="#ff7a45" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></svg>
      <span class="name" style="background:#ff7a45">Jean</span>
    </div>
    <div class="cursor you" data-you aria-hidden="true">
      <svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L6.9 15z" fill="#0d99ff" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></svg>
      <span class="name" style="background:#0d99ff">Vous</span>
    </div>

    <div class="wrap hero-inner">
      <a href="/docs/appel-et-ecoute" class="hero-chip">
        <span class="live-dot"></span>
        <span>L'IA écoute l'appel et dessine pendant que vous parlez</span>
        <span class="arrow">→</span>
      </a>

      <h1 class="display hero-title">
        Parlez.<br />
        <span class="selected title-sel">
          Coall dessine.
          <span class="handle h-tl"></span><span class="handle h-tr"></span><span class="handle h-bl"></span><span class="handle h-br"></span>
          <span class="sel-tag">Titre · Officielle</span>
        </span>
      </h1>

      <p class="lead hero-lead">
        La visio et le canvas, au même endroit. Pendant l'appel, une IA écoute l'équipe et applique les idées sur la maquette,
        en hypothèses que vous comparez et validez. Personne ne s'arrête de réfléchir pour exécuter.
      </p>

      <div class="hero-ctas">
        <a href="/liste-d-attente" class="btn btn-primary">Rejoindre la liste d'attente <span class="arrow">→</span></a>
        <a href="#comment" class="btn btn-ghost">Voir comment ça marche</a>
      </div>
    </div>

    <div class="wrap hero-demo reveal">
      <HeroDemo />
    </div>
  </section>

  <!-- ============ MANIFESTE ============ -->
  <section class="section manifesto">
    <div class="wrap">
      <p class="statement reveal">
        <span class="dim">En réunion, quelqu'un finit toujours par arrêter de réfléchir pour appliquer ce qui se dit.</span>
        Avec Coall, tout le monde parle. L'IA exécute, presque sans écart.
        <span class="dim">Et rien n'est imposé : chaque idée arrive en hypothèse, à côté de l'écran validé.</span>
      </p>
      <div class="for reveal">
        <span class="label">Pour</span>
        <span>Designers</span><i></i><span>Équipes produit</span><i></i><span>Agences</span><i></i><span>Et leurs clients</span>
      </div>
    </div>
  </section>

  <!-- ============ SIX PROMESSES ============ -->
  <section class="section promises" id="promesses">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label label-dot t-ai">Ce que Coall change</span>
        <h2 class="h2">Concevoir ensemble, sans perdre le fil.</h2>
        <p class="lead">Six promesses, tenues dans l'outil aujourd'hui.</p>
      </div>

      <div class="bento">
        <!-- 1. Parlez, l'IA dessine -->
        <article class="card tile t-wide reveal">
          <div class="tile-copy">
            <span class="label t-ai">01 · Voix</span>
            <h3 class="h3">Parlez, l'IA dessine</h3>
            <p>Pendant l'appel, une idée dite à voix haute devient une proposition sur le canvas. Les sous-titres montrent ce que l'IA entend.</p>
          </div>
          <div class="viz viz-voice">
            <div class="vv-sub">
              <span class="vv-who" style="--c:#ff7a45">J</span>
              <div>
                <p class="vv-line">« Ajoute une section témoignages sous les tarifs. »</p>
                <p class="vv-und"><span class="live-dot"></span>Compris : nouvelle section → hypothèse</p>
              </div>
            </div>
            <div class="vv-wave" aria-hidden="true">
              {Array.from({ length: 36 }).map((_, i) => <i style={`--d:${(i % 9) * 0.09}s;--h:${30 + ((i * 37) % 70)}%`}></i>)}
            </div>
            <div class="vv-ghost">
              <span class="vv-tag"><span>✦</span> L'IA prépare une hypothèse… <em>0:04</em></span>
              <div class="vv-body">
                <i></i><i></i><i></i>
                <div class="vv-fill"><span class="ai-wave ai-wave-1"></span><span class="ai-wave ai-wave-2"></span><span class="ai-wave ai-wave-3"></span></div>
              </div>
            </div>
          </div>
        </article>

        <!-- 2. Rien n'est perdu -->
        <article class="card tile t-narrow reveal">
          <div class="tile-copy">
            <span class="label t-hypothesis">02 · Non destructif</span>
            <h3 class="h3">Rien n'est perdu, rien n'est imposé</h3>
            <p>L'IA ne touche jamais directement à un écran validé. Les frames sont archivées, jamais supprimées.</p>
          </div>
          <div class="viz viz-states">
            <div class="st st-off"><span>Accueil</span><b>Officielle</b></div>
            <div class="st st-hyp"><span>Accueil — Version Alice</span><b>Hypothèse</b></div>
            <div class="st st-arc"><span>Accueil (v2)</span><b>Archivée</b></div>
          </div>
        </article>

        <!-- 3. Voir ce qui a bougé -->
        <article class="card tile t-third reveal">
          <div class="tile-copy">
            <span class="label t-warn">03 · Comparer</span>
            <h3 class="h3">Voir ce qui a bougé</h3>
            <p>Chaque hypothèse se compare à l'officielle, différence par différence.</p>
          </div>
          <ul class="viz viz-diff">
            <li><b class="n">1</b><span><em class="t-warn">Modifié</em> Couleur du texte<br /><code>#111111</code> → <code class="g">#16a34a</code></span></li>
            <li><b class="n add">2</b><span><em class="t-hypothesis">Ajouté</em> Bloc « Témoignages »</span></li>
            <li><b class="n del">3</b><span><em style="color:var(--danger)">Retiré</em> Bouton « En savoir plus »</span></li>
          </ul>
        </article>

        <!-- 4. Votre charte, vos règles -->
        <article class="card tile t-third reveal">
          <div class="tile-copy">
            <span class="label t-ai">04 · Skills et règles</span>
            <h3 class="h3">Votre charte, vos règles</h3>
            <p>Des skills et des règles appliqués à chaque demande, avec un assistant qui les construit depuis votre charte en PDF.</p>
          </div>
          <div class="viz viz-skill">
            <div class="sk-file"><span class="sk-ico">MD</span><div><b>mobile-d-abord / SKILL.md</b><span>Toujours concevoir à 390 px d'abord</span></div></div>
            <div class="sk-rules">
              <span class="chip chip-hypothesis">Toujours</span><span class="sk-r">Boutons de 44 px minimum</span>
              <span class="chip" style="color:var(--danger);border-color:color-mix(in srgb,var(--danger) 40%,transparent)">Jamais</span><span class="sk-r">De dégradés</span>
            </div>
          </div>
        </article>

        <!-- 5. Jusqu'à Figma -->
        <article class="card tile t-third reveal">
          <div class="tile-copy">
            <span class="label t-official">05 · Figma</span>
            <h3 class="h3">Jusqu'à Figma</h3>
            <p>Les écrans officiels partent en calques modifiables, avec variables, composants et variantes, et restent synchronisés.</p>
          </div>
          <div class="viz viz-figma">
            <div class="fg-col">
              <span class="fg-h">Variables</span>
              <span class="fg-v"><i style="background:#0d99ff"></i>color/primary</span>
              <span class="fg-v"><i style="background:#14ae5c"></i>color/success</span>
              <span class="fg-v"><i class="rad"></i>radius/md · 8</span>
            </div>
            <div class="fg-col">
              <span class="fg-h">Composants</span>
              <span class="fg-v c">◇ Bouton</span>
              <span class="fg-v sub">Type=Primaire, État=Survol</span>
              <span class="fg-v sub">Type=Secondaire, État=Repos</span>
            </div>
          </div>
        </article>

        <!-- 6. À plusieurs -->
        <article class="card tile t-full reveal">
          <div class="tile-copy">
            <span class="label">06 · Collaboration</span>
            <h3 class="h3">Faits pour travailler à plusieurs</h3>
            <p>Présence en temps réel, commentaires, suivi du point de vue d'un participant, droits par personne. Les invités entrent sans compte.</p>
          </div>
          <div class="viz viz-collab dotgrid">
            <div class="cb-frame">
              <span class="cb-pin" style="--c:#e255a1">AL</span>
              <span class="cb-bubble"><b>Alice</b> Le bouton est trop discret sur mobile.<em>Résoudre</em></span>
              <i class="l1"></i><i class="l2"></i><i class="l3"></i>
            </div>
            <div class="cb-follow"><span class="av" style="--c:#ff7a45">J</span>Vous suivez Jean · <kbd>Échap</kbd></div>
            <div class="cb-rights">
              <span class="cb-row"><span class="av" style="--c:#f5b700">M</span>Marc<span class="chip chip-official">Modifier</span><span class="chip">Valider</span></span>
              <span class="cb-row"><span class="av" style="--c:#8f7cff">S</span>Sophie (invitée)<span class="chip chip-ai">Demande l'accès</span></span>
            </div>
            <div class="cursor" style="left:58%;top:30%">
              <svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L6.9 15z" fill="#ff7a45" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></svg>
              <span class="name" style="background:#ff7a45">Jean</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ COMMENT ÇA MARCHE ============ -->
  <section class="section how" id="comment">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label label-dot t-ai">Comment ça marche</span>
        <h2 class="h2">D'une phrase à un écran dans Figma.</h2>
        <p class="lead">Vous n'avez pas besoin de vous adresser à l'IA. Elle suit la discussion, propose, et attend qu'une personne décide.</p>
      </div>
      <div class="reveal"><Flow /></div>
    </div>
  </section>

  <!-- ============ RÈGLE DE BASE + ATTENTE ============ -->
  <section class="section rule-sec">
    <div class="wrap split">
      <div class="split-copy reveal">
        <span class="label label-dot t-official">La règle de base</span>
        <h2 class="h2">L'IA ne modifie jamais directement un écran validé.</h2>
        <p class="lead">
          À l'écrit comme à la voix, une demande sur un écran officiel crée une hypothèse à côté. Seul le mode
          <b>Officielle</b>, choisi explicitement, modifie l'écran en place.
        </p>
        <dl class="modes">
          <div><dt><span class="chip">Auto</span></dt><dd>L'IA choisit : hypothèse sur un écran validé, création directe pour une nouvelle page ou un nouveau format.</dd></div>
          <div><dt><span class="chip chip-official">Officielle</span></dt><dd>Modifie l'écran officiel directement. Un choix explicite.</dd></div>
          <div><dt><span class="chip chip-hypothesis">Hypothèse</span></dt><dd>Toujours une copie, placée à côté sans chevauchement.</dd></div>
        </dl>
      </div>
      <div class="wait-viz reveal" aria-hidden="true">
        <div class="wv-canvas dotgrid">
          <div class="wv-frame wv-off">
            <span class="wv-tag t-official">Tarifs</span>
            <div class="wv-page"><i></i><i></i><i></i><i></i><div class="wv-scan"></div></div>
          </div>
          <div class="wv-frame wv-ghost">
            <span class="wv-tag t-ai"><span>✦</span> L'IA prépare une hypothèse… <em>0:07</em></span>
            <div class="wv-page"><i></i><i></i><i></i><i></i>
              <div class="wv-fill"><span class="ai-wave ai-wave-1"></span><span class="ai-wave ai-wave-2"></span><span class="ai-wave ai-wave-3"></span></div>
            </div>
          </div>
        </div>
        <p class="wv-cap">Tout le monde voit ce que l'IA prépare, et où. Vos retouches faites pendant l'attente sont gardées.</p>
      </div>
    </div>
  </section>

  <!-- ============ SKILLS (AGENCES) ============ -->
  <section class="section skills">
    <div class="wrap split reverse">
      <div class="split-copy reveal">
        <span class="label label-dot t-ai">Skills et règles</span>
        <h2 class="h2">Votre agence ne fait que des applications&nbsp;? Coall aussi.</h2>
        <p class="lead">
          Un skill apprend à l'IA votre façon de faire : charte graphique, formats d'écran, composants maison. Une règle tient en une phrase,
          <b>Toujours</b> ou <b>Jamais</b>. Ils s'appliquent à toutes les demandes de vos projets, celles des invités comprises.
        </p>
        <ul class="ticks">
          <li>Un assistant pose ses questions, lit votre charte en PDF et vos captures, puis propose le skill.</li>
          <li><b>Essayer (sans et avec)</b> : la même page générée côte à côte, avant d'adopter le skill.</li>
          <li>Format des skills de Claude : un dossier avec un <code>SKILL.md</code>, et ses jetons en <code>tokens.json</code>.</li>
        </ul>
        <a href="/docs/skills-et-regles" class="btn btn-ghost">Lire le guide des skills <span class="arrow">→</span></a>
      </div>
      <div class="assistant reveal" aria-hidden="true">
        <div class="as-head"><span class="spark">✦</span> Construire avec l'assistant IA</div>
        <div class="as-msgs">
          <p class="me">Nous ne concevons que des applications. Toujours en mobile d'abord.</p>
          <p class="bot">Quelle largeur de référence&nbsp;? Faut-il aussi une version tablette&nbsp;? Avez-vous une charte à joindre&nbsp;?</p>
          <p class="me att"><span class="pdf">PDF</span> charte-studio.pdf · 390 px, puis 768 px</p>
        </div>
        <div class="as-try">
          <div>
            <span class="label">Sans</span>
            <div class="try-desk"><i></i><i></i><i></i></div>
          </div>
          <div>
            <span class="label t-hypothesis">Avec le skill</span>
            <div class="try-mob"><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
        <div class="as-foot"><span class="btn btn-sm btn-primary">Ajouter à ma bibliothèque</span></div>
      </div>
    </div>
  </section>

  <!-- ============ MODE PLAY ============ -->
  <section class="section play">
    <div class="wrap split">
      <div class="split-copy reveal">
        <span class="label label-dot t-ai">Mode Play</span>
        <h2 class="h2">Parcourez le prototype, en pleine réunion.</h2>
        <p class="lead">
          Le bouton ▶ d'une frame l'ouvre en plein écran : la page défile, les survols réagissent, les liens mènent aux autres écrans du
          projet, dans le même format. Idéal en partage d'écran avec un client, sans rien préparer.
        </p>
        <p class="note">Le mode Play montre le canvas actuel, en lecture. Il ne fait ni transitions ni interactions programmées : la finition se fait dans Figma.</p>
      </div>
      <div class="play-viz reveal" aria-hidden="true">
        <div class="pv-bar">
          <span>←</span><span class="pv-screens">Accueil ▾</span>
          <span class="pv-dev"><i class="on">Ordinateur</i><i>Tablette</i><i>Mobile</i></span>
          <span>Recommencer</span><span class="pv-quit">Quitter</span>
        </div>
        <div class="pv-page">
          <div class="pv-nav"><b>Lumen</b><span class="lk">Collection</span><span class="lk">Tarifs</span><span class="lk btn-l">Commencer</span></div>
          <div class="pv-h"></div><div class="pv-h s"></div>
          <div class="pv-grid"><i></i><i></i><i></i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COALL → FIGMA ============ -->
  <section class="section journey">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="label label-dot t-official">Votre flux de travail</span>
        <h2 class="h2">Concevoir et décider dans Coall.<br /><span class="dim">Finir dans Figma.</span></h2>
      </div>
      <div class="jr reveal">
        <div class="jr-col card">
          <p class="label">Dans Coall</p>
          <ul>
            <li>Importer un site, un export Claude Design ou partir d'une frame blanche</li>
            <li>En appel, explorer à voix haute, en hypothèses</li>
            <li>Comparer, décider, garder la trace dans la timeline</li>
            <li>Versions tablette et mobile, composants et variantes</li>
          </ul>
        </div>
        <div class="jr-mid">
          <span class="jr-plug">Coall ⇄ Figma</span>
          <span class="jr-line"></span>
          <span class="dim jr-small">Écrans officiels, variables,<br />composants et variantes</span>
        </div>
        <div class="jr-col card">
          <p class="label">Dans Figma</p>
          <ul>
            <li>Une page <b>Écrans</b>, rangée par section</li>
            <li>De vrais calques texte, icônes en vecteurs, auto layout</li>
            <li>Les retouches faites dans Figma sont gardées par défaut</li>
            <li>Seul ce qui a changé revient à la synchronisation suivante</li>
          </ul>
        </div>
      </div>
      <p class="jr-note dim reveal">Le plugin requiert l'application Figma pour ordinateur. Il s'installe pour l'instant en mode développement : il n'est pas encore publié dans la communauté Figma.</p>
    </div>
  </section>

  <!-- ============ CONFIANCE ============ -->
  <section class="section trust">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label label-dot">Confiance</span>
        <h2 class="h2">L'IA écoute quand vous le décidez.<br /><span class="dim">Pas une seconde de plus.</span></h2>
      </div>
      <div class="trust-grid">
        <div class="card tr reveal"><span class="tr-ico"><span class="live-dot"></span></span><h3 class="h3">Un indicateur visible</h3><p>L'IA n'écoute que lorsque « L'IA écoute » est allumé, et seulement les personnes qui ont donné leur accord.</p></div>
        <div class="card tr reveal"><span class="tr-ico">⏸</span><h3 class="h3">Pause pour tous</h3><p>N'importe qui la met en pause, au bouton ou à la voix (« l'IA, pause »). La reprise se fait au bouton.</p></div>
        <div class="card tr reveal"><span class="tr-ico">≡</span><h3 class="h3">Transcription sur accord</h3><p>Conservée seulement avec un accord distinct de chacun, et si l'hôte ne l'a pas désactivée.</p></div>
        <div class="card tr reveal"><span class="tr-ico">⧉</span><h3 class="h3">Accès limité</h3><p>Un projet n'est ouvert qu'à ses membres. Les invités entrent par un lien à usage unique, valable 12 heures.</p></div>
      </div>
      <a href="/docs/confidentialite-et-securite" class="trust-link reveal">Tous nos engagements <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section final" id="liste">
    <div class="final-bg dotgrid" aria-hidden="true"></div>
    <div class="wrap final-inner reveal">
      <h2 class="h1">Votre prochaine réunion<br />peut produire les écrans.</h2>
      <p class="lead">Coall n'est pas encore en ligne. Inscrivez-vous pour l'essayer parmi les premiers.</p>
      <Waitlist id="wl-home" />
    </div>
  </section>
</Base>

<script>
  // Votre curseur « Vous » suit la souris dans le hero, comme dans un canvas multijoueur.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const you = document.querySelector<HTMLElement>("[data-you]");
  if (hero && you && window.matchMedia("(pointer: fine)").matches) {
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      you.style.opacity = "1";
      you.style.transform = `translate(${e.clientX - r.left + 14}px, ${e.clientY - r.top + 14}px)`;
    });
    hero.addEventListener("pointerleave", () => (you.style.opacity = "0"));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(56px, 9vw, 112px) 0 clamp(64px, 8vw, 120px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    -webkit-mask: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    mask: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }
  .hero-glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 1100px;
    height: 600px;
    transform: translateX(-50%);
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--ai) 22%, transparent), transparent),
      radial-gradient(closest-side at 30% 60%, color-mix(in srgb, var(--official) 16%, transparent), transparent),
      radial-gradient(closest-side at 70% 60%, color-mix(in srgb, var(--hypothesis) 12%, transparent), transparent);
    filter: blur(30px);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 28px;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ai) 35%, transparent);
    background: var(--ai-soft);
    color: var(--ai-ink);
    font-size: 13.5px;
    font-weight: 500;
    max-width: 100%;
  }
  .hero-chip span:nth-child(2) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-chip:hover .arrow {
    transform: translateX(3px);
  }
  .hero-chip .arrow {
    transition: transform 0.2s;
  }
  .hero-title {
    margin-top: 12px;
  }
  .title-sel {
    display: inline-block;
    padding: 0 0.04em;
    outline-offset: 8px;
    background: linear-gradient(180deg, #fff 30%, #b9b9c2);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .title-sel .sel-tag {
    top: -34px;
    left: -10px;
  }
  .title-sel > .handle {
    top: auto;
  }
  .title-sel > .h-tl {
    top: -13px;
    left: -13px;
  }
  .title-sel > .h-tr {
    top: -13px;
    right: -13px;
  }
  .title-sel > .h-bl {
    bottom: -13px;
    left: -13px;
  }
  .title-sel > .h-br {
    bottom: -13px;
    right: -13px;
  }
  .hero-lead {
    max-width: 640px;
  }
  .hero-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-demo {
    position: relative;
    margin-top: clamp(56px, 7vw, 88px);
  }
  .amb {
    z-index: 2;
    animation: drift 14s ease-in-out infinite;
  }
  .amb-1 {
    left: 14%;
    top: 30%;
  }
  .amb-2 {
    right: 16%;
    top: 46%;
    animation-delay: -5s;
    animation-duration: 17s;
  }
  @keyframes drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(40px, -24px);
    }
    66% {
      transform: translate(-20px, 30px);
    }
  }
  .you {
    left: 0;
    top: 0;
    opacity: 0;
    transition:
      opacity 0.2s,
      transform 0.12s linear;
    z-index: 3;
  }
  @media (max-width: 900px) {
    .amb {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .title-sel .sel-tag {
      display: none;
    }
    .hero-chip {
      font-size: 12.5px;
    }
  }

  /* ---------- Manifeste ---------- */
  .manifesto {
    padding-top: clamp(40px, 6vw, 80px);
  }
  .statement {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.18;
    letter-spacing: -0.03em;
    font-weight: 550;
    max-width: 1020px;
    margin: 0;
  }
  .for {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    color: var(--ink-2);
    font-size: 15px;
  }
  .for i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--faint);
  }

  /* ---------- Bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px;
    overflow: hidden;
    min-width: 0;
  }
  .t-wide {
    grid-column: span 4;
  }
  .t-narrow {
    grid-column: span 2;
  }
  .t-third {
    grid-column: span 2;
  }
  .t-full {
    grid-column: span 6;
    flex-direction: row;
    align-items: center;
  }
  .t-full .tile-copy {
    flex: 0 0 34%;
  }
  .tile-copy {
    display: grid;
    gap: 10px;
  }
  .tile-copy .label {
    font-size: 11px;
  }
  .tile-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .viz {
    margin-top: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    padding: 16px;
    font-size: 13px;
  }
  @media (max-width: 960px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .t-wide,
    .t-full {
      grid-column: span 2;
    }
    .t-narrow,
    .t-third {
      grid-column: span 1;
    }
    .t-third:last-of-type {
      grid-column: span 2;
    }
    .t-full {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .bento > * {
      grid-column: span 1 !important;
    }
    .tile {
      padding: 22px;
    }
  }

  /* Voix */
  .viz-voice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: stretch;
  }
  .vv-sub {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .vv-who {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c);
    color: #111;
    font-weight: 700;
    display: grid;
    place-items: center;
    font-size: 12px;
  }
  .vv-line {
    margin: 0;
    font-size: 15px;
    color: var(--ink);
  }
  .vv-und {
    margin: 8px 0 0;
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ai-ink);
    font-size: 13px;
  }
  .vv-wave {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 3px;
    height: 44px;
  }
  .vv-wave i {
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    background: linear-gradient(var(--ai), var(--official));
    opacity: 0.8;
    animation: speak 1.1s ease-in-out infinite;
    animation-delay: var(--d);
    transform-origin: center;
  }
  .vv-ghost {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vv-tag {
    font-size: 12px;
    color: var(--ai-ink);
    font-weight: 550;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vv-tag em {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--muted);
    font-weight: 400;
  }
  .vv-body {
    position: relative;
    flex: 1;
    min-height: 110px;
    border-radius: 3px;
    outline: 2px dashed color-mix(in srgb, var(--ai) 80%, transparent);
    background: color-mix(in srgb, var(--ai) 6%, var(--surface));
    overflow: hidden;
    padding: 14px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .vv-body > i {
    height: 9px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--ai) 18%, transparent);
  }
  .vv-body > i:nth-child(2) {
    width: 70%;
    height: 16px;
  }
  .vv-body > i:nth-child(3) {
    width: 45%;
  }
  .vv-fill,
  .wv-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55%;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--ai) 20%, transparent), color-mix(in srgb, var(--official) 28%, transparent));
    animation: rise 7s ease-out infinite;
  }
  @keyframes rise {
    0% {
      height: 6%;
    }
    80%,
    100% {
      height: 78%;
    }
  }
  @media (max-width: 640px) {
    .viz-voice {
      grid-template-columns: 1fr;
    }
    .vv-ghost {
      grid-column: 1;
      grid-row: auto;
    }
  }

  /* États des frames */
  .viz-states {
    display: grid;
    gap: 10px;
  }
  .st {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border-radius: 4px;
    font-size: 13px;
    background: var(--surface);
  }
  .st span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .st b {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 3px;
    flex: none;
  }
  .st-off {
    outline: 2px solid var(--official);
  }
  .st-off b {
    background: #0a6ccf;
    color: #fff;
  }
  .st-hyp {
    outline: 2px solid var(--hypothesis);
    color: var(--hypothesis-ink);
  }
  .st-hyp b {
    background: #0b7a3e;
    color: #fff;
  }
  .st-arc {
    outline: 2px dashed var(--archived);
    color: var(--muted);
    opacity: 0.7;
  }
  .st-arc b {
    background: #3a3a3f;
    color: #ddd;
  }

  /* Diff */
  .viz-diff {
    list-style: none;
    margin: auto 0 0;
    display: grid;
    gap: 0;
    padding: 6px 16px;
  }
  .viz-diff li {
    display: flex;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .viz-diff li:first-child {
    border-top: 0;
  }
  .viz-diff em {
    font-style: normal;
    font-weight: 600;
    margin-right: 4px;
  }
  .n {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--warn);
    color: #111;
    font-size: 10.5px;
    display: grid;
    place-items: center;
  }
  .n.add {
    background: var(--hypothesis);
  }
  .n.del {
    background: var(--danger);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  code.g {
    color: var(--hypothesis-ink);
  }

  /* Skill */
  .viz-skill {
    display: grid;
    gap: 14px;
  }
  .sk-file {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .sk-file div {
    display: grid;
    min-width: 0;
  }
  .sk-file b {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sk-file span:not(.sk-ico) {
    color: var(--muted);
    font-size: 12.5px;
  }
  .sk-ico {
    flex: none;
    width: 34px;
    height: 40px;
    border-radius: 5px;
    background: var(--ai-soft);
    border: 1px solid color-mix(in srgb, var(--ai) 40%, transparent);
    color: var(--ai-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    display: grid;
    place-items: center;
  }
  .sk-rules {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 10px;
    align-items: center;
  }
  .sk-r {
    font-size: 13px;
    color: var(--ink-2);
  }

  /* Figma */
  .viz-figma {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .fg-col {
    display: grid;
    gap: 7px;
    align-content: start;
    min-width: 0;
  }
  .fg-h {
    font-size: 11px;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }
  .fg-v {
    display: flex;
    gap: 7px;
    align-items: center;
    font-size: 12.5px;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fg-v i {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .fg-v i.rad {
    border: 1.5px solid var(--muted);
    border-radius: 4px 0 0 0;
    border-right: 0;
    border-bottom: 0;
  }
  .fg-v.c {
    color: var(--ai-ink);
  }
  .fg-v.sub {
    padding-left: 14px;
    color: var(--muted);
    font-size: 11.5px;
    display: block;
  }

  /* Collaboration */
  .viz-collab {
    flex: 1;
    position: relative;
    min-height: 220px;
    margin-top: 0;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 16px;
    align-items: center;
    overflow: hidden;
  }
  .cb-frame {
    position: relative;
    grid-row: span 2;
    height: 180px;
    border-radius: 3px;
    background: #fff;
    outline: 2px solid var(--official);
    padding: 18px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .cb-frame > i {
    height: 10px;
    border-radius: 4px;
    background: #ececec;
  }
  .cb-frame > i.l1 {
    width: 60%;
    height: 18px;
    background: #dcdcdc;
  }
  .cb-frame > i.l3 {
    width: 30%;
    height: 22px;
    border-radius: 99px;
    background: #111;
  }
  .cb-pin {
    position: absolute;
    left: 30%;
    bottom: 22px;
    width: 26px;
    height: 26px;
    border-radius: 50% 50% 50% 4px;
    background: var(--c);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .cb-bubble {
    position: absolute;
    left: calc(30% + 34px);
    bottom: 10px;
    max-width: 220px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #1c1c1e;
    border: 1px solid #2f2f31;
    font-size: 12px;
    color: #ddd;
    z-index: 2;
    display: grid;
    gap: 2px;
  }
  .cb-bubble em {
    font-style: normal;
    color: var(--official-ink);
    font-size: 11.5px;
  }
  .cb-follow {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: #ff7a45;
    color: #111;
    font-weight: 600;
    font-size: 12.5px;
  }
  .cb-follow kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    background: rgba(0, 0, 0, 0.15);
    padding: 0 5px;
    border-radius: 4px;
  }
  .av {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c);
    color: #111;
    font-size: 11px;
    font-weight: 700;
    display: inline-grid;
    place-items: center;
    flex: none;
  }
  .cb-rights {
    display: grid;
    gap: 8px;
  }
  .cb-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .viz-collab {
      grid-template-columns: 1fr;
    }
    .cb-frame {
      grid-row: auto;
    }
    .viz-collab .cursor {
      display: none;
    }
  }

  /* ---------- Splits ---------- */
  .split {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .split.reverse .split-copy {
    order: 2;
  }
  .split-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .split-copy b {
    color: var(--ink);
    font-weight: 600;
  }
  .note {
    margin: 0;
    color: var(--faint);
    font-size: 14px;
    border-left: 2px solid var(--line-2);
    padding-left: 14px;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split.reverse .split-copy {
      order: 0;
    }
  }

  .modes {
    margin: 4px 0 0;
    display: grid;
    gap: 14px;
    width: 100%;
  }
  .modes div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    align-items: start;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .modes dd {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 480px) {
    .modes div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  /* Attente de l'IA */
  .wait-viz {
    display: grid;
    gap: 14px;
  }
  .wv-canvas {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    padding: 48px 28px 28px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background-color: #121213;
  }
  .wv-frame {
    position: relative;
  }
  .wv-tag {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    font-size: 12px;
    font-weight: 550;
    white-space: nowrap;
  }
  .wv-tag em {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--muted);
    font-weight: 400;
  }
  .wv-page {
    position: relative;
    overflow: hidden;
    height: 260px;
    border-radius: 2px;
    padding: 16px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .wv-off .wv-page {
    background: #fff;
    outline: 2px solid var(--official);
  }
  .wv-ghost .wv-page {
    background: color-mix(in srgb, var(--ai) 6%, var(--surface));
    outline: 2px dashed color-mix(in srgb, var(--ai) 80%, transparent);
  }
  .wv-page > i {
    height: 10px;
    border-radius: 4px;
    background: #e6e6e6;
  }
  .wv-ghost .wv-page > i {
    background: color-mix(in srgb, var(--ai) 18%, transparent);
  }
  .wv-page > i:nth-child(2) {
    height: 20px;
    width: 80%;
  }
  .wv-page > i:nth-child(4) {
    height: 80px;
  }
  .wv-scan {
    position: absolute;
    inset: 0 0 auto 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--ai) 22%, transparent));
    border-bottom: 2px solid color-mix(in srgb, var(--ai) 70%, transparent);
    animation: scan 2.4s ease-in-out infinite;
  }
  @keyframes scan {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(360%);
    }
  }
  .wv-cap {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 480px) {
    .wv-canvas {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .wv-page {
      height: 180px;
    }
  }

  /* Skills / assistant */
  .ticks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
    color: var(--muted);
    font-size: 15px;
  }
  .ticks li {
    position: relative;
    padding-left: 24px;
  }
  .ticks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1.5px solid var(--hypothesis);
    background: var(--hypothesis-soft);
  }
  .ticks code {
    color: var(--ink-2);
  }
  .assistant {
    border-radius: 18px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .as-head {
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 14px;
    display: flex;
    gap: 8px;
  }
  .spark {
    color: var(--ai);
  }
  .as-msgs {
    padding: 18px;
    display: grid;
    gap: 10px;
  }
  .as-msgs p {
    margin: 0;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    max-width: 86%;
  }
  .as-msgs .me {
    justify-self: end;
    background: var(--surface-3);
    border-bottom-right-radius: 4px;
  }
  .as-msgs .bot {
    background: var(--ai-soft);
    color: var(--ai-ink);
    border-bottom-left-radius: 4px;
  }
  .as-msgs .att {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .pdf {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 5px;
    border-radius: 3px;
    background: #c9252c;
    color: #fff;
  }
  .as-try {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 16px;
    padding: 0 18px 18px;
    align-items: end;
  }
  .as-try .label {
    font-size: 10.5px;
    display: block;
    margin-bottom: 8px;
  }
  .try-desk,
  .try-mob {
    background: #fff;
    border-radius: 3px;
    padding: 10px;
    display: grid;
    gap: 6px;
  }
  .try-desk {
    height: 110px;
    outline: 2px solid var(--line-2);
    grid-template-columns: repeat(3, 1fr);
    align-content: end;
  }
  .try-desk i {
    height: 50px;
    background: #ececec;
    border-radius: 3px;
  }
  .try-mob {
    width: 76px;
    height: 150px;
    outline: 2px solid var(--hypothesis);
    align-content: start;
  }
  .try-mob i {
    height: 14px;
    border-radius: 3px;
    background: #ececec;
  }
  .try-mob i:nth-child(2) {
    height: 40px;
  }
  .try-mob i:last-child {
    height: 18px;
    border-radius: 99px;
    background: #111;
  }
  .as-foot {
    padding: 14px 18px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
  }

  /* Play */
  .play-viz {
    border-radius: 14px;
    overflow: hidden;
