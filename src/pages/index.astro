---
import Base from "../layouts/Base.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Flow from "../components/Flow.astro";
import Waitlist from "../components/Waitlist.astro";
import FigmaHandoff from "../components/visuals/FigmaHandoff.astro";
import SkillAssistant from "../components/visuals/SkillAssistant.astro";
import PreJoin from "../components/visuals/PreJoin.astro";
import PlayV from "../components/visuals/Play.astro";

const cursor = (color: string) =>
  `<svg viewBox="0 0 18 18"><path d="M2 1.5 L15.5 8.2 L9.2 9.6 L6.4 15.8 Z" fill="${color}" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg>`;
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero data-you-zone>
    <div class="aura" aria-hidden="true"></div>
    <div class="hero-bg dotgrid" aria-hidden="true"></div>

    <!-- Curseurs des participants (comme sur le canvas de l'outil) ; le vôtre suit la souris. -->
    <div class="cursor amb" data-alice aria-hidden="true">
      <Fragment set:html={cursor("#9334e6")} /><span class="name" style="background:#9334e6">Alice</span>
    </div>
    <div class="cursor amb amb-2" aria-hidden="true">
      <Fragment set:html={cursor("#c25100")} /><span class="name" style="background:#c25100">Jean</span>
    </div>

    <div class="wrap hero-inner">
      <h1 class="display hero-title">
        <span class="hov" data-hov>Parlez.</span><br />
        <span class="title-sel" data-sel>Coall dessine.<span class="handle h-tl"></span><span class="handle h-tr"></span><span class="handle h-bl"></span><span class="handle h-br"></span><span class="sel-tag">Titre · Officielle</span><span class="sel-size">W 1440</span></span>
      </h1>
      <p class="lead hero-lead">
        La visio et le canvas, au même endroit. Pendant l'appel, une IA écoute l'équipe et applique les idées sur la maquette,
        en hypothèses que vous comparez et validez. Personne ne s'arrête de réfléchir pour exécuter.
      </p>
      <div class="hero-ctas">
        <a href="/liste-d-attente" class="btn btn-primary">Rejoindre la liste d'attente</a>
        <a href="#comment" class="btn btn-ghost">Voir comment ça marche</a>
      </div>
    </div>
    <div class="wrap hero-demo halo">
      <HeroDemo />
    </div>
  </section>

  <!-- ============ MANIFESTE ============ -->
  <section class="section manifesto">
    <div class="wrap">
      <p class="statement reveal">
        En réunion, quelqu'un finit toujours par arrêter de réfléchir pour appliquer ce qui se dit.
        <span class="dim">Avec Coall, tout le monde parle et l'IA exécute. Chaque idée arrive en hypothèse, à côté de l'écran validé, et rien ne change sans qu'une personne le décide.</span>
      </p>
      <p class="for reveal">Pour les designers, les équipes produit, les agences et leurs clients.</p>
    </div>
  </section>

  <!-- ============ FONCTIONNALITÉS ============ -->
  <section class="section features" id="fonctionnalites">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label">Fonctionnalités</span>
        <h2 class="h2">Concevoir ensemble,<br />sans perdre le fil.</h2>
        <p class="lead">Six choses que Coall fait aujourd'hui, de la première phrase dite en appel jusqu'aux calques dans Figma.</p>
      </div>

      <div class="grid">
        <!-- Voix -->
        <article class="feat reveal">
          <div class="viz">
            <div class="vz-voice">
              <p class="vv-line"><b style="color:#ff7a45">Jean</b> Ajoute une section témoignages sous les tarifs.</p>
              <p class="vv-und"><span class="live-dot"></span>Compris : nouvelle section, en hypothèse</p>
              <div class="vv-ghost">
                <span class="vv-tag">L'IA prépare une hypothèse… <em>0:04</em></span>
                <div class="vv-body">
                  <i></i><i></i><i></i>
                  <div class="vv-fill"><span class="ai-wave ai-wave-1"></span><span class="ai-wave ai-wave-2"></span><span class="ai-wave ai-wave-3"></span></div>
                </div>
              </div>
            </div>
          </div>
          <p class="ft"><b>Parlez, l'IA dessine.</b> Une idée dite à voix haute devient une proposition sur le canvas. Les sous-titres montrent ce que l'IA entend.</p>
        </article>

        <!-- Non destructif -->
        <article class="feat reveal">
          <div class="viz">
            <div class="vz-states">
              <div class="st st-off"><span>Accueil</span><b>Officielle</b></div>
              <div class="st st-hyp"><span>Accueil · Version Alice</span><b>Hypothèse</b></div>
              <div class="st st-arc"><span>Accueil, v2</span><b>Archivée</b></div>
            </div>
          </div>
          <p class="ft"><b>Rien n'est perdu.</b> L'IA ne touche jamais directement un écran validé. Les frames sont archivées, jamais supprimées.</p>
        </article>

        <!-- Comparer -->
        <article class="feat reveal">
          <div class="viz">
            <ul class="vz-diff">
              <li><b class="n">1</b><span>Couleur du texte<br /><code>#111111</code> → <code class="g">#16a34a</code></span></li>
              <li><b class="n add">2</b><span>Bloc « Témoignages » ajouté</span></li>
              <li><b class="n del">3</b><span>Bouton « En savoir plus » retiré</span></li>
            </ul>
          </div>
          <p class="ft"><b>Voir ce qui a bougé.</b> Chaque hypothèse se compare à l'officielle, différence par différence, avec l'avant et l'après.</p>
        </article>

        <!-- Skills -->
        <article class="feat reveal">
          <div class="viz">
            <div class="vz-skill">
              <div class="sk-file"><span class="sk-ico">MD</span><div><b>mobile-d-abord/SKILL.md</b><span>Toujours concevoir à 390 px d'abord</span></div></div>
              <div class="sk-rules">
                <span class="sk-k">Toujours</span><span>Boutons de 44 px minimum</span>
                <span class="sk-k">Jamais</span><span>De dégradés</span>
              </div>
            </div>
          </div>
          <p class="ft"><b>Votre charte, vos règles.</b> Des skills et des règles appliqués à chaque demande. Un assistant les construit depuis votre charte en PDF.</p>
        </article>

        <!-- Figma -->
        <article class="feat reveal">
          <div class="viz">
            <div class="vz-figma">
              <div class="fg-col">
                <span class="fg-h">Variables</span>
                <span class="fg-v"><i style="background:#0d99ff"></i>color/primary</span>
                <span class="fg-v"><i style="background:#14ae5c"></i>color/success</span>
                <span class="fg-v"><i style="background:#3a3a3f"></i>radius/md</span>
              </div>
              <div class="fg-col">
                <span class="fg-h">Composants</span>
                <span class="fg-v c">◇ Bouton</span>
                <span class="fg-v sub">Type=Primaire, État=Survol</span>
                <span class="fg-v sub">Type=Secondaire, État=Repos</span>
              </div>
            </div>
          </div>
          <p class="ft"><b>Jusqu'à Figma.</b> Les écrans officiels partent en calques modifiables, avec variables, composants et variantes, et restent synchronisés.</p>
        </article>

        <!-- Collaboration -->
        <article class="feat reveal">
          <div class="viz">
            <div class="vz-collab dotgrid">
              <div class="cb-frame"><i class="l1"></i><i></i><i class="l3"></i></div>
              <span class="cb-pin">AL</span>
              <span class="cb-bubble"><b>Alice</b> Le bouton est trop discret sur mobile.</span>
              <div class="cursor" style="left:66%;top:22%" set:html={cursor("#ff7a45") + '<span class="name" style="background:#ff7a45">Jean</span>'} />
            </div>
          </div>
          <p class="ft"><b>À plusieurs.</b> Présence en temps réel, commentaires, suivi d'un participant, droits par personne. Les invités entrent sans compte.</p>
        </article>
      </div>
      <a href="/fonctionnalites" class="btn-link more reveal">Toutes les fonctionnalités <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- ============ COMMENT ÇA MARCHE ============ -->
  <section class="section how" id="comment">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label">Comment ça marche</span>
        <h2 class="h2">D'une phrase<br />à un écran dans Figma.</h2>
        <p class="lead">Personne n'a besoin de s'adresser à l'IA. Elle suit la discussion, propose, et attend qu'une personne décide.</p>
      </div>
      <div class="reveal"><Flow /></div>
    </div>
  </section>

  <!-- ============ RÈGLE DE BASE ============ -->
  <section class="section">
    <div class="wrap split">
      <div class="split-copy reveal">
        <span class="label">La règle de base</span>
        <h2 class="h2">L'IA ne modifie jamais directement un écran validé.</h2>
        <p class="lead">
          À l'écrit comme à la voix, une demande sur un écran officiel crée une hypothèse à côté. Seul le mode
          <b>Officielle</b>, choisi explicitement, modifie l'écran en place.
        </p>
        <dl class="modes">
          <div><dt>Auto</dt><dd>L'IA choisit : une hypothèse sur un écran validé, une création directe pour une nouvelle page ou un nouveau format.</dd></div>
          <div><dt>Officielle</dt><dd>Modifie l'écran officiel directement. C'est un choix explicite.</dd></div>
          <div><dt>Hypothèse</dt><dd>Toujours une copie, placée à côté sans chevauchement.</dd></div>
        </dl>
      </div>
      <figure class="wait reveal">
        <div class="shot wv-canvas dotgrid" aria-hidden="true">
          <div class="wv-frame wv-off">
            <span class="wv-tag t-official">Tarifs</span>
            <div class="wv-page"><i></i><i></i><i></i><i></i><div class="wv-scan"></div></div>
          </div>
          <div class="wv-frame wv-ghost">
            <span class="wv-tag t-ai">L'IA prépare une hypothèse… <em>0:07</em></span>
            <div class="wv-page"><i></i><i></i><i></i><i></i>
              <div class="wv-fill"><span class="ai-wave ai-wave-1"></span><span class="ai-wave ai-wave-2"></span><span class="ai-wave ai-wave-3"></span></div>
            </div>
          </div>
        </div>
        <figcaption>Tout le monde voit ce que l'IA prépare, et où. Les retouches faites pendant l'attente sont gardées.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label">Skills et règles</span>
        <h2 class="h2">Votre agence ne fait que des applications&nbsp;? Coall aussi.</h2>
        <p class="lead">
          Un skill apprend à l'IA votre façon de faire : charte graphique, formats d'écran, composants maison. Une règle tient en une phrase,
          <b>Toujours</b> ou <b>Jamais</b>. Les deux s'appliquent à toutes les demandes de vos projets, celles des invités comprises.
        </p>
      </div>
      <div class="reveal sk-vis halo"><SkillAssistant /></div>
      <ul class="lines three reveal">
        <li>L'assistant pose ses questions, lit votre charte en PDF et vos captures, puis propose le skill.</li>
        <li><b>Essayer (sans et avec)</b> génère la même page côte à côte, avant d'adopter le skill.</li>
        <li>Le format est celui des skills de Claude : un dossier avec un <code>SKILL.md</code>. <a href="/docs/skills-et-regles" class="inl">Le guide des skills</a></li>
      </ul>
    </div>
  </section>

  <!-- ============ MODE PLAY ============ -->
  <section class="section">
    <div class="wrap split">
      <div class="split-copy reveal">
        <span class="label">Mode Play</span>
        <h2 class="h2">Parcourez le prototype pendant la réunion.</h2>
        <p class="lead">
          Le bouton ▶ d'une frame l'ouvre en plein écran. La page défile, les survols réagissent, les liens mènent aux autres écrans du
          projet, dans le même format. Pratique en partage d'écran avec un client.
        </p>
        <p class="note">Le mode Play montre le canvas actuel, en lecture. Il ne fait ni transitions ni interactions programmées : la finition se fait dans Figma.</p>
      </div>
      <div class="reveal halo"><PlayV /></div>
    </div>
  </section>

  <!-- ============ COALL → FIGMA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label">Votre flux de travail</span>
        <h2 class="h2">Concevoir et décider dans Coall.<br /><span class="dim">Finir dans Figma.</span></h2>
        <p class="lead">À la fin de la réunion, le plugin Coall ⇄ Figma envoie les écrans validés, leurs variables, leurs composants et leurs variantes.</p>
      </div>
      <div class="reveal halo"><FigmaHandoff /></div>
      <p class="jr-note reveal">Le plugin requiert l'application Figma pour ordinateur. Il s'installe pour l'instant en mode développement et n'est pas encore publié dans la communauté Figma.</p>
    </div>
  </section>

  <!-- ============ CONFIANCE ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="label">Confiance</span>
        <h2 class="h2">L'IA écoute quand vous le décidez.</h2>
        <p class="lead">Ces engagements sont tenus par l'outil lui-même. <a href="/docs/confidentialite-et-securite" class="inl">Les lire en détail</a>.</p>
      </div>
      <div class="reveal pj-wrap halo"><PreJoin /></div>
      <div class="trust reveal">
        <div><h3 class="h3">Un indicateur visible</h3><p>L'IA n'écoute que lorsque « L'IA écoute » est allumé, et seulement les personnes qui ont donné leur accord.</p></div>
        <div><h3 class="h3">Pause pour tous</h3><p>N'importe qui la met en pause, au bouton ou à la voix. La reprise se fait au bouton.</p></div>
        <div><h3 class="h3">Transcription sur accord</h3><p>Elle n'est conservée qu'avec un accord distinct de chacun, et si l'hôte ne l'a pas désactivée.</p></div>
        <div><h3 class="h3">Accès limité</h3><p>Un projet n'est ouvert qu'à ses membres. Les invités entrent par un lien à usage unique, valable 12 heures.</p></div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section final">
    <div class="aura final-aura" aria-hidden="true"></div>
    <div class="wrap final-inner reveal">
      <h2 class="h1">Votre prochaine réunion<br /><span class="dim">peut produire les écrans.</span></h2>
      <p class="lead">Coall n'est pas encore en ligne. Inscrivez-vous pour l'essayer parmi les premiers.</p>
      <Waitlist id="wl-home" />
    </div>
  </section>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const sel = document.querySelector<HTMLElement>("[data-sel]");
  const hov = document.querySelector<HTMLElement>("[data-hov]");
  const alice = document.querySelector<HTMLElement>("[data-alice]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && sel && alice) {
    const place = (x: number, y: number) => (alice.style.transform = `translate(${x}px, ${y}px)`);
    const rel = (el: HTMLElement, fx: number, fy: number) => {
      const h = hero.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return [r.left - h.left + r.width * fx, r.top - h.top + r.height * fy] as const;
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const click = async () => {
      alice.classList.add("click");
      await wait(140);
      alice.classList.remove("click");
    };
    // Alice entre, survole « Parlez. », puis clique sur « Coall dessine. » : la sélection apparaît.
    const run = async () => {
      if (reduce) {
        sel.classList.add("on");
        place(...rel(sel, 0.92, 0.95));
        return;
      }
      const h = hero.getBoundingClientRect();
      alice.style.transition = "none";
      place(h.width * 0.08, h.height * 0.32);
      await wait(50);
      alice.style.transition = "";
      await wait(700);
      place(...rel(hov!, 0.6, 0.6));
      await wait(900);
      hov?.classList.add("on");
      await wait(500);
      hov?.classList.remove("on");
      place(...rel(sel, 0.72, 0.62));
      await wait(1100);
      await click();
      sel.classList.add("on");
      await wait(900);
      place(...rel(sel, 1.06, 1.2));
    };
    document.fonts?.ready.then(run) ?? run();
  }

  // Survoler le titre le surligne, comme sur le canvas.
  hov?.addEventListener("pointerenter", () => hov.classList.add("on"));
  hov?.addEventListener("pointerleave", () => hov.classList.remove("on"));
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(72px, 10vw, 136px) 0 clamp(72px, 9vw, 120px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    -webkit-mask: radial-gradient(ellipse 60% 45% at 50% 22%, #000 25%, transparent 75%);
    mask: radial-gradient(ellipse 60% 45% at 50% 22%, #000 25%, transparent 75%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 28px;
  }
  .hero-title {
    font-size: clamp(46px, 7.4vw, 92px);
    line-height: 1.02;
  }
  .hov {
    display: inline-block;
    outline: 1px solid transparent;
    outline-offset: 6px;
    transition: outline-color 0.12s;
  }
  .hov.on {
    outline-color: var(--official);
  }
  .title-sel {
    position: relative;
    display: inline-block;
    outline: 1px solid transparent;
    outline-offset: 8px;
    transition: outline-color 0.1s;
  }
  .title-sel > .handle,
  .title-sel > .sel-tag,
  .title-sel > .sel-size {
    position: absolute;
    opacity: 0;
    transition: opacity 0.1s;
  }
  .title-sel.on {
    outline-color: var(--official);
  }
  .title-sel.on > * {
    opacity: 1;
  }
  .title-sel > .handle {
    width: 8px;
    height: 8px;
    background: #fff;
    border: 1px solid var(--official);
    border-radius: 1px;
  }
  .title-sel > .h-tl { top: -12px; left: -12px; }
  .title-sel > .h-tr { top: -12px; right: -12px; }
  .title-sel > .h-bl { bottom: -12px; left: -12px; }
  .title-sel > .h-br { bottom: -12px; right: -12px; }
  .title-sel > .sel-tag {
    top: -36px;
    left: -8px;
    font-size: 12px;
    font-weight: 510;
    letter-spacing: 0;
    line-height: 1;
    color: var(--official-ink);
    white-space: nowrap;
  }
  .title-sel > .sel-size {
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 3px;
    background: var(--official);
    color: #fff;
    white-space: nowrap;
  }
  .hero-lead {
    max-width: 620px;
    margin-top: 20px;
  }
  .hero-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-demo {
    position: relative;
    margin-top: clamp(56px, 7vw, 88px);
  }
  .amb {
    z-index: 3;
    left: 0;
    top: 0;
    transition: transform 1.1s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .amb-2 {
    left: auto;
    right: 15%;
    top: 40%;
    animation: drift 16s ease-in-out infinite;
    transition: none;
  }
  .amb.click svg {
    transform: scale(0.86);
    transition: transform 0.08s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(36px, -22px); }
    66% { transform: translate(-18px, 26px); }
  }
  @media (max-width: 900px) {
    .amb-2 { display: none; }
  }
  @media (max-width: 640px) {
    .title-sel > .sel-tag,
    .title-sel > .sel-size { display: none; }
    [data-alice] { display: none; }
  }

  /* ---------- Manifeste ---------- */
  .manifesto {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .statement {
    font-size: clamp(24px, 2.9vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 510;
    max-width: 980px;
    margin: 0;
  }
  .for {
    margin: 32px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* ---------- Fonctionnalités ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 24px;
  }
  .feat {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 20px;
    min-width: 0;
  }
  .viz {
    height: 220px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    padding: 20px;
    font-size: 13px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ft {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .ft b {
    color: var(--ink);
    font-weight: 510;
  }
  .more {
    margin-top: 48px;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .vz-voice {
    display: grid;
    gap: 6px;
  }
  .vv-line {
    margin: 0;
    color: var(--ink-2);
  }
  .vv-line b {
    font-weight: 510;
    margin-right: 4px;
  }
  .vv-und {
    margin: 0 0 8px;
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ai-ink);
    font-size: 12.5px;
  }
  .vv-ghost {
    display: grid;
    gap: 6px;
  }
  .vv-tag {
    font-size: 12px;
    color: var(--ai-ink);
  }
  .vv-tag em,
  .wv-tag em {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .vv-body {
    position: relative;
    height: 84px;
    border-radius: 2px;
    outline: 1.5px dashed color-mix(in srgb, var(--ai) 75%, transparent);
    background: color-mix(in srgb, var(--ai) 5%, var(--surface));
    overflow: hidden;
    padding: 12px;
    display: grid;
