---
import Base from "../layouts/Base.astro";
---
<Base title="Page introuvable">
  <section class="nf">
    <div class="wrap nf-in">
      <div class="nf-frame"><span class="t">Page introuvable</span><span class="chip">Archivée</span></div>
      <h1 class="h1">Cette page n'existe pas.<br /><span class="dim">Rien n'est jamais supprimé, pourtant.</span></h1>
      <a href="/" class="btn btn-primary">Revenir à l'accueil</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 120px 0; min-height: 70vh; }
  .nf-in { display: grid; gap: 28px; justify-items: start; }
  .nf-frame { width: 260px; height: 160px; border: 2px dashed var(--archived); border-radius: 3px; position: relative; opacity: .7; }
  .nf-frame .t { position: absolute; bottom: calc(100% + 6px); left: 0; font-size: 12px; color: var(--muted); }
  .nf-frame .chip { position: absolute; top: 12px; right: 12px; }
</style>
