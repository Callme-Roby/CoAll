---
/** Visuel de l'outil inséré dans la doc à la place d'une capture : `<div class="capture" data-shot="clé">Légende</div>`.
    Chaque clé correspond à un fichier de src/components/docshots/. */
interface Props { k: string; caption?: string }
const { k, caption } = Astro.props;
const mods = import.meta.glob<{ default: any }>("./docshots/*.astro", { eager: true });
const Comp = mods[`./docshots/${k}.astro`]?.default;
if (!Comp) throw new Error(`DocShot : visuel inconnu « ${k} »`);
---
<figure class="docshot" data-pagefind-ignore>
  <div class="docshot-v"><Comp /></div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .docshot {
    margin: 28px 0;
  }
  /* Plateau neutre : les visuels étroits (panneaux, fenêtres) y sont centrés, les larges le remplissent. */
  .docshot-v {
    display: grid;
    justify-items: center;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 12px;
    /* Reflet discret des trois couleurs sous le visuel. */
    background:
      radial-gradient(60% 45% at 22% 100%, rgba(13, 153, 255, 0.07), transparent),
      radial-gradient(60% 45% at 50% 100%, rgba(169, 121, 255, 0.09), transparent),
      radial-gradient(60% 45% at 78% 100%, rgba(20, 174, 92, 0.06), transparent),
      var(--bg-2);
  }
  .docshot-v > :global(*) {
    width: 100%;
  }
  /* Jamais plus grand que sa taille dessinée : les panneaux étroits restent à l'échelle 1. */
  .docshot-v :global([data-scaled]) {
    max-width: var(--w);
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .docshot-v {
      padding: 14px;
    }
  }
  figcaption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--faint);
  }
  figcaption :global(strong) {
    color: var(--ink-2);
    font-weight: 550;
  }
</style>
