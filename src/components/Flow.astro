---
/** Le trajet d'une idée, en graphe de nœuds reliés : de la voix jusqu'à Figma. */
const nodes = [
  { k: "01", t: "Voix", c: "ai", d: "Chacun parle normalement. Les sous-titres montrent exactement ce que l'IA entend.", ui: "sub" },
  { k: "02", t: "Compris", c: "ai", d: "L'IA trie la conversation : idée claire, idée incertaine, désaccord ou décision.", ui: "und" },
  { k: "03", t: "Hypothèse", c: "hypothesis", d: "La proposition arrive à côté de l'écran validé, jamais par-dessus.", ui: "hyp" },
  { k: "04", t: "Comparer", c: "warn", d: "Chaque différence avec l'officielle, numérotée, avec l'avant → après.", ui: "diff" },
  { k: "05", t: "Décision", c: "official", d: "« On garde ça » : une personne autorisée valide, l'officielle est archivée.", ui: "dec" },
  { k: "06", t: "Figma", c: "official", d: "Les écrans officiels partent en calques modifiables, avec variables et composants.", ui: "fig" },
];
---
<div class="flow" data-flow>
  <svg class="edges" data-edges aria-hidden="true"></svg>
  {nodes.map((n) => (
    <article class={`node n-${n.c}`} data-node>
      <span class="port in" data-in></span>
      <span class="port out" data-out></span>
      <header><span class="t">{n.t}</span></header>
      <div class="ui">
        {n.ui === "sub" && <p class="sub"><b>Marc</b> en plus sombre, ça passerait peut-être mieux<span class="caret"></span></p>}
        {n.ui === "und" && <p class="und"><span class="live-dot"></span>Compris : fond plus sombre, en hypothèse</p>}
        {n.ui === "hyp" && <div class="mini"><span class="m-tag">Accueil <i>· Version Marc</i></span><span class="m-frame"></span></div>}
        {n.ui === "diff" && <ul class="dl"><li><b>1</b>Fond : <code>#ffffff</code> → <code>#14161a</code></li><li><b>2</b>Couleur du texte : <code>#111111</code> → <code>#f2f2f3</code></li></ul>}
        {n.ui === "dec" && <p class="dec"><span class="ok">✓ Promouvoir</span><span class="dim">Alice · 14:02</span></p>}
        {n.ui === "fig" && <ul class="layers"><li>▾ Écrans</li><li class="i">▾ Accueil</li><li class="ii">◇ Bouton · Type=Primaire</li><li class="ii">T Titre</li></ul>}
      </div>
      <p class="d">{n.d}</p>
    </article>
  ))}
</div>

<script>
  function draw(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>("[data-edges]")!;
    const nodes = [...root.querySelectorAll<HTMLElement>("[data-node]")];
    const box = root.getBoundingClientRect();
    svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
    svg.setAttribute("width", String(box.width));
    svg.setAttribute("height", String(box.height));
    let html = "";
    for (let i = 0; i < nodes.length - 1; i++) {
      const a = nodes[i].querySelector("[data-out]")!.getBoundingClientRect();
      const b = nodes[i + 1].querySelector("[data-in]")!.getBoundingClientRect();
      const x1 = a.left + a.width / 2 - box.left;
      const y1 = a.top + a.height / 2 - box.top;
      const x2 = b.left + b.width / 2 - box.left;
      const y2 = b.top + b.height / 2 - box.top;
      let d: string;
      const r = 14;
      if (Math.abs(x2 - x1) < 40) {
        // Une colonne : de bas en haut.
        const my = (y1 + y2) / 2;
        d = `M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}`;
      } else if (x2 < x1) {
        // Retour à la ligne : on passe par l'allée entre les deux rangées.
        const gy = (nodes[i].getBoundingClientRect().bottom + nodes[i + 1].getBoundingClientRect().top) / 2 - box.top;
        const ox = x1 + 24;
        const ix = x2 - 24;
        d = `M${x1},${y1} H${ox - r} Q${ox},${y1} ${ox},${y1 + r} V${gy - r} Q${ox},${gy} ${ox - r},${gy} H${ix + r} Q${ix},${gy} ${ix},${gy + r} V${y2 - r} Q${ix},${y2} ${ix + r},${y2} H${x2}`;
      } else {
        const dx = Math.max(40, (x2 - x1) / 2);
        d = `M${x1},${y1} C${x1 + dx},${y1} ${x2 - dx},${y2} ${x2},${y2}`;
      }
      html += `<path class="e" d="${d}"/>`;
    }
    svg.innerHTML = html;
  }
  document.querySelectorAll<HTMLElement>("[data-flow]").forEach((root) => {
    const run = () => draw(root);
    new ResizeObserver(run).observe(root);
    document.fonts?.ready.then(run);
  });
</script>

<style>
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px 72px;
  }
  .edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }
  .edges :global(.e) {
    fill: none;
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1;
  }
  .node {
    --c: var(--ai);
    position: relative;
    z-index: 1;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 0 0 16px;
  }
  .n-hypothesis {
    --c: var(--hypothesis);
  }
  .n-official {
    --c: var(--official);
  }
  .n-warn {
    --c: var(--warn);
  }
  .node header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    border-radius: 12px 12px 0 0;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c);
  }
  .t {
    font-weight: 510;
    font-size: 15px;
  }
  .port {
    position: absolute;
    top: 22px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--faint);
  }
  .port.in {
    left: -6px;
  }
  .port.out {
    right: -6px;
  }
  .ui {
    margin: 14px 16px 0;
    min-height: 74px;
    padding: 12px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 13px;
    display: flex;
    align-items: center;
  }
  .ui p,
  .ui ul {
    margin: 0;
  }
  .d {
    margin: 12px 16px 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  .sub b {
    color: #f5b700;
    margin-right: 4px;
  }
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 14px;
    background: var(--ink);
    vertical-align: -2px;
    margin-left: 2px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .und {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ai-ink);
  }
  .mini {
    width: 100%;
    display: grid;
    gap: 6px;
  }
  .m-tag {
    font-size: 12px;
    color: var(--hypothesis-ink);
    font-weight: 550;
  }
  .m-tag i {
    font-style: normal;
    font-weight: 400;
  }
  .m-frame {
    height: 36px;
    border-radius: 3px;
    outline: 2px solid var(--hypothesis);
    background: linear-gradient(#14161a 0 38%, #22252b 38% 52%, #14161a 52%);
  }
  .dl {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .dl b {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--warn);
    color: #111;
    font-size: 10px;
    margin-right: 7px;
  }
  code {
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .dec {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 12.5px;
  }
  .ok {
    padding: 4px 10px;
    border-radius: 6px;
    background: #0a6ccf;
    color: #fff;
    font-weight: 600;
  }
  .layers {
    list-style: none;
    padding: 0;
    font-size: 12.5px;
    display: grid;
    gap: 3px;
    color: var(--ink-2);
  }
  .layers .i {
    padding-left: 14px;
  }
  .layers .ii {
    padding-left: 28px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .flow {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 56px;
    }
  }
  @media (max-width: 620px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .port.in {
      left: 50%;
      top: -6px;
      transform: translateX(-50%);
    }
    .port.out {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -6px;
      transform: translateX(-50%);
    }
  }
</style>
