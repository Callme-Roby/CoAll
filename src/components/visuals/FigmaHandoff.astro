---
/**
 * Passation Coall → Figma, en trois temps :
 * 1. Coall : l'onglet Ressources (composants, variables) et la planche « Composants » ;
 * 2. le plugin « Coall ⇄ Figma » (400 × 560, libellés de figma-plugin/src/ui.html et ui-sync.ts) ;
 * 3. le fichier Figma : pages Écrans / Composants / Archives Coall, jeu de composants, variables.
 */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
import BrandMark from "../BrandMark.astro";

/** only : n'affiche qu'un des trois panneaux (pour la documentation). */
interface Props { only?: "coall" | "plugin" | "figma" }
const { only } = Astro.props;
const show = (k: string) => !only || only === k;

const variants = [
  ["Primaire", "Repos"],
  ["Primaire", "Survol"],
  ["Secondaire", "Repos"],
  ["Secondaire", "Survol"],
  ["Tertiaire", "Repos"],
  ["Tertiaire", "Survol"],
];
---
<div class:list={["fh", { solo: only }]}>
  <!-- 1. Coall -->
  {show("coall") && <figure class="col">
    <Scaled w={460} h={640} label="Coall : l'onglet Ressources liste les composants et les variables du projet, à côté de la planche Composants.">
      <div class="tui-win coall">
        <div class="ct"><BrandMark size={14} /><b>Lumen · Site vitrine</b></div>
        <div class="split">
          <aside class="res">
            <div class="tabs"><span class="tab">Calques</span><span class="tab on">Ressources</span></div>
            <div class="st"><span>Composants (3)</span></div>
            <div class="cp"><span class="ci"><Icon name="Component" size={13} /></span><b>Bouton</b><span class="cm">6 variantes · 14 occ.</span></div>
            <div class="cv">Type=Primaire, État=Repos</div>
            <div class="cv">Type=Primaire, État=Survol</div>
            <div class="cv">Type=Secondaire, État=Repos</div>
            <div class="cp"><span class="ci"><Icon name="Component" size={13} /></span><b>Carte produit</b><span class="cm">6 occ.</span></div>
            <div class="cp"><span class="ci"><Icon name="Component" size={13} /></span><b>Champ</b><span class="cm">2 occ.</span></div>
            <div class="st"><span>Variables</span></div>
            <p class="vg">Couleurs (4)</p>
            <div class="vr"><i style="background:#111111"></i><span>--color-ink</span><em class="mono">#111111</em></div>
            <div class="vr"><i style="background:#16a34a"></i><span>--color-primary</span><em class="mono">#16a34a</em></div>
            <div class="vr"><i style="background:#f3f1ee"></i><span>--color-surface</span><em class="mono">#f3f1ee</em></div>
            <p class="vg">Arrondis (2)</p>
            <div class="vr"><b class="mono chipv">8</b><span>--radius-md</span></div>
            <div class="vr"><b class="mono chipv">99</b><span>--radius-pill</span></div>
          </aside>
          <div class="cnv">
            <span class="sec-t">Design system</span>
            <div class="sec">
              <span class="ft">Composants</span>
              <div class="board">
                {variants.map(([t, e]) => (
                  <div class="bv">
                    <span class:list={["lb", t.toLowerCase(), { hov: e === "Survol" }]}>Voir la collection</span>
                    <small>Type={t}, État={e}</small>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </Scaled>
    {!only && <figcaption>Dans Coall, les composants et leurs variantes sont repérés dans <b>Ressources</b>.</figcaption>}
  </figure>}

  {!only && <span class="arrow" aria-hidden="true"><Icon name="ArrowRight" size={18} /></span>}

  <!-- 2. Plugin -->
  {show("plugin") && <figure class="col">
    <Scaled w={400} h={640} label="Le plugin Coall ⇄ Figma liste ce qui va arriver dans Figma avant de l'appliquer.">
      <div class="plug">
        <div class="pt"><span>Coall ⇄ Figma</span><Icon name="X" size={14} /></div>
        <nav><span class="on">Depuis Coall</span><span>Vers Coall</span></nav>
        <main>
          <div class="row sb"><span>Connecté : Lumen Studio</span><span class="link">Se déconnecter</span></div>
          <label class="fld">Projet
            <span class="sel-row"><span class="sel">Site vitrine <Icon name="ChevronDown" size={12} /></span><span class="ic">↻</span></span>
          </label>
          <div class="check"><span class="box on"><Icon name="Check" size={10} stroke={3} /></span><div><b>Positions fixes, au pixel près</b><p>Chaque calque à sa position mesurée, sans auto layout : rien ne se réorganise dans Figma.</p></div></div>
          <span class="pbtn">Lire le projet</span>
          <p class="sum">« Site vitrine » : 2 nouvelles, 1 différence, 1 archivée, 4 à jour.</p>
          <ul class="report">
            <li><span class="tag new">Nouvelle</span>Accueil<span class="why">1440 px — sera ajoutée</span></li>
            <li><span class="tag new">Nouvelle</span>Composants<span class="why">1440 px — sera ajoutée</span></li>
            <li><span class="tag chg">Différence</span>Tarifs<span class="why">Modifiée dans Coall</span>
              <span class="choice"><span><i class="rd on"></i>Coall remplace</span><span><i class="rd"></i>Garder Figma</span></span></li>
            <li><span class="tag arc">Archivée</span>Accueil — v1<span class="why">N'est plus officielle dans Coall</span>
              <span class="choice"><span><span class="box on sm"><Icon name="Check" size={9} stroke={3} /></span>Ranger dans « Archives Coall »</span></span></li>
          </ul>
          <span class="pbtn">Appliquer dans Figma (3 frames à créer, 1 à ranger)</span>
        </main>
      </div>
    </Scaled>
    {!only && <figcaption>Le plugin montre ce qui change avant d'écrire quoi que ce soit dans Figma.</figcaption>}
  </figure>}

  {!only && <span class="arrow" aria-hidden="true"><Icon name="ArrowRight" size={18} /></span>}

  <!-- 3. Fichier Figma -->
  {show("figma") && <figure class="col">
    <Scaled w={400} h={640} label="Dans Figma : les pages Écrans, Composants et Archives Coall, le jeu de composants Bouton et les variables du projet.">
      <div class="fig">
        <div class="fg-sec">
          <p class="fg-h">Pages</p>
          <p class="pg">Écrans</p>
          <p class="pg on">Composants</p>
          <p class="pg">Archives Coall</p>
        </div>
        <div class="fg-sec">
          <p class="fg-h">Calques</p>
          <p class="ly"><Icon name="ChevronDown" size={11} /><span class="lyi set"><Icon name="LayoutGrid" size={11} /></span>Bouton</p>
          {variants.slice(0, 4).map(([t, e]) => (
            <p class="ly d1"><span class="lyi cmp"><Icon name="Component" size={11} /></span>Type={t}, État={e}</p>
          ))}
          <p class="ly"><Icon name="ChevronRight" size={11} /><span class="lyi cmp"><Icon name="Component" size={11} /></span>Carte produit</p>
          <p class="ly"><Icon name="ChevronRight" size={11} /><span class="lyi cmp"><Icon name="Component" size={11} /></span>Champ</p>
        </div>
        <div class="fg-sec">
          <p class="fg-h">Variables locales · Site vitrine</p>
          <p class="va"><i style="background:#111111"></i>Couleurs/color-ink<em>var(--color-ink)</em></p>
          <p class="va"><i style="background:#16a34a"></i>Couleurs/color-primary<em>var(--color-primary)</em></p>
          <p class="va"><i style="background:#f3f1ee"></i>Couleurs/color-surface<em>var(--color-surface)</em></p>
          <p class="va"><b>#</b>Typographie/Taille/16</p>
          <p class="va"><b>#</b>Arrondis/8</p>
          <p class="va"><b>Aa</b>Typographie/Police/Inter</p>
        </div>
        <p class="done">Figma est à jour : 2 ajoutées, 1 remplacée, 1 rangée dans les archives, 9 variables créées, 1 jeu de composants à variantes, 3 composants créés, 14 instances.</p>
      </div>
    </Scaled>
    {!only && <figcaption>Dans Figma : des calques modifiables, un jeu de composants et des variables nommées comme dans le code.</figcaption>}
  </figure>}
</div>

<style>
  .fh {
    display: grid;
    grid-template-columns: 460fr auto 400fr auto 400fr;
    gap: 14px;
    align-items: start;
  }
  .fh.solo {
    grid-template-columns: minmax(0, 1fr);
    max-width: 400px;
  }
  .col {
    margin: 0;
    min-width: 0;
  }
  .col :global(.sc) {
    border-radius: 12px;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  figcaption b {
    color: var(--ink);
    font-weight: 510;
  }
  .arrow {
    align-self: center;
    margin-top: -40px;
    color: var(--faint);
  }
  @media (max-width: 900px) {
    .fh {
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 440px;
      margin: 0 auto;
    }
    .arrow {
      margin: -4px auto;
      transform: rotate(90deg);
    }
  }

  /* --- Coall --- */
  .coall {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .ct {
    height: 40px;
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .ct b {
    font-weight: 600;
  }
  .split {
    flex: 1;
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 0;
  }
  .res {
    border-right: 1px solid var(--line);
    overflow: hidden;
  }
  .cp {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
  }
  .cp b {
    font-weight: 500;
  }
  .ci {
    display: grid;
    color: var(--ai);
  }
  .cm {
    margin-left: auto;
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
  }
  .cv {
    padding: 2px 12px 2px 32px;
    font-size: 11px;
    color: var(--muted);
  }
  .vg {
    padding: 4px 12px 2px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted) !important;
  }
  .vr {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
  }
  .vr i {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid var(--line);
    flex: none;
  }
  .vr em {
    margin-left: auto;
    font-style: normal;
    font-size: 10px;
    color: var(--muted);
  }
  .chipv {
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    border-radius: 3px;
    background: var(--hover);
    font-size: 9.5px;
    font-weight: 400;
    display: grid;
    place-items: center;
  }
  .cnv {
    position: relative;
    background-color: var(--canvas);
    background-image: radial-gradient(#333336 1px, transparent 1.3px);
    background-size: 24px 24px;
    padding: 46px 16px 16px;
  }
  .sec-t {
    position: absolute;
    left: 16px;
    top: 16px;
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--panel);
    font-size: 13px;
    font-weight: 600;
  }
  .sec {
    border: 2px solid var(--line);
    background: rgba(42, 42, 45, 0.6);
    border-radius: 18px;
    padding: 34px 12px 12px;
    position: relative;
    height: 100%;
  }
  .ft {
    position: absolute;
    left: 12px;
    top: 12px;
    color: var(--off-ink);
    font-weight: 500;
  }
  .board {
    background: #fff;
    outline: 1px solid var(--off);
    padding: 14px 10px;
    display: grid;
    gap: 12px;
    color: #111;
  }
  .bv {
    display: grid;
    gap: 3px;
    justify-items: start;
    position: relative;
  }
  .bv small {
    font-size: 8.5px;
    color: #8a8a8a;
    font-family: Inter, system-ui, sans-serif;
  }
  .lb {
    font-family: Inter, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 99px;
    outline: 1px dashed rgba(169, 121, 255, 0.7);
    outline-offset: 2px;
  }
  .lb.primaire {
    background: #16a34a;
    color: #fff;
  }
  .lb.primaire.hov {
    background: #128a3e;
  }
  .lb.secondaire {
    background: #fff;
    color: #111;
    box-shadow: inset 0 0 0 1.5px #111;
  }
  .lb.secondaire.hov {
    background: #f3f1ee;
  }
  .lb.tertiaire {
    color: #16a34a;
    padding-left: 0;
    padding-right: 0;
    border-radius: 2px;
  }
  .lb.tertiaire.hov {
    text-decoration: underline;
  }

  /* --- Plugin (fenêtre Figma, thème sombre de Figma) --- */
  .plug {
    width: 400px;
    height: 640px;
    background: #2c2c2c;
    color: #fff;
    border-radius: 12px;
    border: 1px solid #444;
    overflow: hidden;
    font: 12px/1.5 Inter, system-ui, sans-serif;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.8);
  }
  .pt {
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid #444;
    font-weight: 600;
  }
  .plug nav {
    display: flex;
    gap: 2px;
    padding: 8px 12px 0;
    border-bottom: 1px solid #444;
  }
  .plug nav span {
    height: 30px;
    line-height: 30px;
    padding: 0 10px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  .plug nav span.on {
    color: #fff;
    border-bottom-color: #0c8ce9;
  }
  .plug main {
    padding: 12px 16px 16px;
    display: grid;
    gap: 10px;
  }
  .row.sb {
    display: flex;
    justify-content: space-between;
  }
  .link {
    color: #4cb0ff;
    font-weight: 500;
  }
  .fld {
    display: grid;
    gap: 4px;
    color: rgba(255, 255, 255, 0.7);
  }
  .sel-row {
    display: flex;
    gap: 6px;
  }
  .sel {
    flex: 1;
    height: 32px;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
  }
  .ic {
    width: 32px;
    height: 32px;
    border: 1px solid #444;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-size: 16px;
    color: #fff;
  }
  .check {
    display: flex;
    gap: 8px;
  }
  .check b {
    font-weight: 500;
  }
  .check p {
    color: rgba(255, 255, 255, 0.7);
  }
  .box {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #777;
    display: inline-grid;
    place-items: center;
    margin-top: 2px;
  }
  .box.on {
    background: #0c8ce9;
    border-color: #0c8ce9;
    color: #fff;
  }
  .box.sm {
    width: 12px;
    height: 12px;
    margin: 0;
  }
  .pbtn {
    height: 36px;
    border-radius: 6px;
    background: #0c8ce9;
    color: #fff;
    font-weight: 600;
    display: grid;
    place-items: center;
  }
  .sum {
    color: #fff;
  }
  .report {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid #444;
    border-radius: 8px;
  }
  .report li {
    padding: 8px 10px;
    border-top: 1px solid #444;
  }
  .report li:first-child {
    border-top: 0;
  }
  .tag {
    padding: 0 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    margin-right: 6px;
  }
  .tag.new {
    background: #e5f4ff;
    color: #0a6ccf;
  }
  .tag.chg {
    background: #fff1d6;
    color: #8a5a00;
  }
  .tag.arc {
    background: #383838;
    color: rgba(255, 255, 255, 0.7);
  }
  .why {
    display: block;
    color: rgba(255, 255, 255, 0.7);
  }
  .choice {
    display: flex;
    gap: 12px;
    margin-top: 4px;
  }
  .choice > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .rd {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid #777;
  }
  .rd.on {
    border: 4px solid #0c8ce9;
  }

  /* --- Fichier Figma --- */
  .fig {
    width: 400px;
    height: 640px;
    background: #2c2c2c;
    color: #fff;
    border-radius: 12px;
    border: 1px solid #444;
    overflow: hidden;
    font: 11px/1.45 Inter, system-ui, sans-serif;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.8);
  }
  .fg-sec {
    padding: 10px 0 8px;
    border-bottom: 1px solid #444;
  }
  .fg-h {
    padding: 0 14px 6px;
    font-weight: 600;
  }
  .pg {
    padding: 4px 14px;
    color: rgba(255, 255, 255, 0.8);
  }
  .pg.on {
    background: #383838;
    color: #fff;
    font-weight: 600;
  }
  .ly {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 14px;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
  .ly.d1 {
    padding-left: 44px;
  }
  .lyi {
    display: grid;
  }
  .lyi.set,
  .lyi.cmp {
    color: #a979ff;
  }
  .va {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
  }
  .va i {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #555;
    flex: none;
  }
  .va b {
    width: 14px;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    font-size: 10px;
  }
  .va em {
    margin-left: auto;
    font-style: normal;
    color: rgba(255, 255, 255, 0.5);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10px;
  }
  .done {
    margin: 12px 14px !important;
    padding: 10px 12px;
    border-radius: 8px;
    background: #383838;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }
</style>
