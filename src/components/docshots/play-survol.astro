---
/** Une frame survolée : le bouton ▶ (Play.tsx : PlayButton) apparaît en haut à droite. */
import Scaled from "../Scaled.astro";
import Canvas from "./_kit/Canvas.astro";
import Frame from "./_kit/Frame.astro";
import Site from "./_a/Site.astro";
---
<Scaled w={720} h={440} label="Au survol d'une frame, le bouton lecture apparaît en haut à droite, au-dessus de la page.">
  <div class="q">
    <Canvas>
      <Frame x={60} y={60} w={290} h={340} name="Accueil" play><Site scale={0.92} /></Frame>
      <Frame x={400} y={60} w={290} h={340} name="Tarifs"><Site page="tarifs" scale={0.92} /></Frame>
      <svg class="cur" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 1.5 L15.5 8.2 L9.2 9.6 L6.4 15.8 Z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" />
      </svg>
    </Canvas>
  </div>
</Scaled>
<style>
  .q {
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .q :global(.kfr .kt) {
    color: var(--muted);
  }
  .cur {
    position: absolute;
    left: 268px;
    top: 132px;
    z-index: 4;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }
</style>
