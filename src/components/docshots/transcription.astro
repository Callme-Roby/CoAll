---
/** Onglet Timeline › Transcription (components/editor/TranscriptPanel.tsx) : prises de parole,
    phrase soulignée survolée et carte d'aperçu de la version créée à ce moment. */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
import Canvas from "./_kit/Canvas.astro";
import Site from "./_kit/Site.astro";
import Frame from "./_kit/Frame.astro";

// [phrase, soulignée (a créé une étape), survolée]
const turns: { ini: string; c: string; n: string; t: string; lines: [string, boolean, boolean][] }[] = [
  { ini: "AB", c: "#9334e6", n: "Alice Bernard", t: "14:08", lines: [["On regarde les tarifs ?", false, false], ["Il manque des avis clients, je trouve.", false, false]] },
  { ini: "MD", c: "#007b83", n: "Marc Duval", t: "14:09", lines: [["Ajoute une section témoignages sous les formules.", true, true]] },
  { ini: "JM", c: "#c25100", n: "Jean Morel", t: "14:10", lines: [["Moi je garderais la page comme elle est.", false, false], ["Faisons les deux versions.", true, false]] },
  { ini: "AB", c: "#9334e6", n: "Alice Bernard", t: "14:12", lines: [["Ok, on garde la version de Marc.", true, false]] },
];
---
<Scaled w={900} h={560} label="L'onglet Timeline › Transcription : qui a parlé et quand ; au survol d'une phrase soulignée, la carte montre l'étape qu'elle a créée et la version de ce moment.">
  <div class="tui-win tr">
    <Canvas>
      <Frame x={30} y={90} w={250} h={330} name="Tarifs" kind="arch"><Site page="tarifs" /></Frame>
      <Frame x={305} y={90} w={250} h={330} name="Tarifs" kind="off" label="Version Marc"><Site page="tarifs"><p class="quote">« On a validé l’accueil en une réunion. »</p></Site></Frame>
      <div class="card">
        <div class="ch">
          <p class="cs"><Icon name="MessageSquareText" size={12} /><span>Ajouter une section témoignages sous les tarifs</span></p>
          <p class="cm">Version créée à 14:09 · cliquez pour l’ouvrir</p>
        </div>
        <div class="thumb">
          <div class="pg"><Site page="tarifs"><p class="quote">« On a validé l’accueil en une réunion. »</p></Site></div>
          <span class="fn">Tarifs</span>
        </div>
      </div>
    </Canvas>

    <aside class="rp">
      <div class="tabs">
        <span class="tab">Design</span><span class="tab on">Timeline</span><span class="tab">Versions</span>
        <span class="tab"><Icon name="MessageCircle" size={14} /></span><span class="tab">Personnes</span>
      </div>
      <div class="st"><span>Note-timeline</span><span class="ex"><Icon name="FileText" size={12} />.md<Icon name="FileDown" size={12} />PDF</span></div>
      <div class="seg2"><i>Étapes</i><i class="on">Transcription (14)</i></div>
      <label class="keep">
        <span class="cb"><Icon name="Check" size={9} stroke={3} /></span>
        <span><b>Conserver la transcription de l’appel</b><em>Seulement pour les personnes qui l’ont acceptée, quand l’IA écoute.</em></span>
      </label>
      <ol class="turns">
        {turns.map((u) => (
          <li>
            <span class="av" style={`background:${u.c}`}>{u.ini}</span>
            <div>
              <p class="who"><b>{u.n}</b><span>{u.t}</span></p>
              <p class="txt">
                {u.lines.map(([s, lk, hov]) => <><span class:list={[{ lk, hov }]}>{s}</span>{" "}</>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</Scaled>

<style>
  .tr {
    width: 900px;
    height: 560px;
    display: grid;
    grid-template-columns: 1fr 320px;
    border-radius: 12px;
  }
  .card {
    position: absolute;
    right: 12px;
    top: 190px;
    width: 280px;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    font-size: 11px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.7);
  }
  .ch {
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
  }
  .cs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .cs span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .quote {
    margin-top: 6px !important;
    padding: 8px;
    border-radius: 5px;
    background: #f3f1ee;
    font-size: 9px;
    font-style: italic;
    color: #333;
  }
  .cs :global(svg) {
    color: var(--ai);
  }
  .cm {
    margin-top: 2px !important;
    color: var(--muted);
  }
  .thumb {
    position: relative;
    height: 160px;
    overflow: hidden;
    background: #fff;
  }
  .pg {
    width: 560px;
    height: 320px;
    transform: scale(0.5);
    transform-origin: 0 0;
  }
  .fn {
    position: absolute;
    left: 4px;
    bottom: 4px;
    padding: 0 4px;
    border-radius: 3px;
    background: rgba(28, 28, 30, 0.9);
    color: var(--muted);
    font-size: 10px;
  }
  .rp {
    border-left: 1px solid var(--line);
    background: var(--panel);
    min-width: 0;
  }
  .tab {
    padding: 0 6px;
  }
  .ex {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 400;
    color: var(--muted);
  }
  .ex :global(svg:nth-of-type(2)) {
    margin-left: 6px;
  }
  .seg2 {
    margin: 0 12px 8px;
    display: flex;
    padding: 2px;
    border-radius: 6px;
    background: var(--hover);
    font-size: 11px;
  }
  .seg2 i {
    flex: 1;
    font-style: normal;
    text-align: center;
    height: 24px;
    line-height: 24px;
    border-radius: 5px;
    font-weight: 500;
    color: var(--muted);
  }
  .seg2 i.on {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .keep {
    margin: 0 12px 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    background: var(--hover);
    font-size: 11px;
  }
  .keep b {
    display: block;
    font-weight: 500;
  }
  .keep em {
    display: block;
    font-style: normal;
    color: var(--muted);
  }
  .cb {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--off);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .turns {
    list-style: none;
    margin: 0;
    padding: 4px 12px 0;
    display: grid;
    gap: 12px;
  }
  .turns li {
    display: flex;
    gap: 8px;
  }
  .av {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 9px;
    font-weight: 600;
  }
  .who {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 11px;
  }
  .who b {
    font-weight: 600;
  }
  .who span {
    color: var(--muted);
  }
  .txt {
    line-height: 1.625;
    color: rgba(236, 236, 236, 0.9);
  }
  .lk {
    color: var(--ink);
    text-decoration: underline dotted rgba(169, 121, 255, 0.7);
    text-underline-offset: 4px;
  }
  .hov {
    background: var(--ai-soft);
    border-radius: 2px;
  }
</style>
