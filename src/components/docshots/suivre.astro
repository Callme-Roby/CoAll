---
/** Suivre quelqu'un (components/editor/Follow.tsx) : cadre à sa couleur autour de la vue et bandeau « Vous suivez … ». */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
import Canvas from "./_kit/Canvas.astro";
import Frame from "./_kit/Frame.astro";
import Site from "./_kit/Site.astro";
const jean = "#c25100";
---
<Scaled w={960} h={540} label="Vous suivez Jean Morel : un cadre à sa couleur entoure la vue, un bandeau le rappelle avec le bouton Arrêter.">
  <div class="tui-win sv" style={`--c:${jean}`}>
    <Canvas>
      <Frame x={80} y={110} w={300} h={380} name="Tarifs" kind="off"><Site page="tarifs" /></Frame>
      <Frame x={420} y={110} w={300} h={380} name="Tarifs" kind="hyp" label="Version Marc"><Site page="tarifs" title="Des formules claires" /></Frame>
      <Frame x={760} y={110} w={300} h={380} name="Contact" kind="off"><Site page="contact" /></Frame>

      <div class="cur" style="left:560px;top:250px">
        <svg width="18" height="18" viewBox="0 0 18 18"><path d="M2 1.5 L15.5 8.2 L9.2 9.6 L6.4 15.8 Z" fill={jean} stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></svg>
        <span>Jean</span>
      </div>

      <div class="ring"></div>
      <div class="banner">
        <Icon name="Eye" size={13} />Vous suivez Jean Morel
        <span class="stop"><Icon name="X" size={12} />Arrêter</span>
      </div>
    </Canvas>
  </div>
</Scaled>

<style>
  .sv {
    width: 960px;
    height: 540px;
    border-radius: 12px;
  }
  .ring {
    position: absolute;
    inset: 0;
    border: 3px solid var(--c);
    z-index: 4;
  }
  .banner {
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 4px 4px 12px;
    border-radius: 99px;
    background: var(--c);
    color: #fff;
    font-weight: 500;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
    z-index: 5;
  }
  .stop {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 24px;
    padding: 0 8px;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.25);
  }
  .cur {
    position: absolute;
    z-index: 3;
  }
  .cur svg {
    display: block;
  }
  .cur span {
    position: absolute;
    left: 14px;
    top: 16px;
    padding: 1px 6px;
    border-radius: 99px;
    background: var(--c);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
