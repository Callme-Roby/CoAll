---
/** Fenêtre « Importer une maquette » au moment du choix de la largeur (components/editor/ImportDialog.tsx, components/ImportSizes.tsx). */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
---
<div style="max-width:440px;margin:0 auto">
<Scaled w={440} h={258} label="Fenêtre d'import : « 3 pages à 1440 px, 1 page à 390 px », avec le choix Garder ces tailles ou Une même largeur pour toutes les pages, et le bouton Importer à ces tailles.">
  <div class="tui-win dlg">
    <div class="hd"><b>Importer une maquette</b><Icon name="X" size={16} /></div>
    <div class="bd">
      <div>
        <div data-t="p" class="nm">lumen-site-vitrine.zip</div>
        <div data-t="p" class="sz">3 pages à 1440 px, 1 page à 390 px</div>
      </div>
      <div>
        <div data-t="p" class="lg">Taille des pages</div>
        <div data-t="p" class="opt on"><i class="rd on"></i>Garder ces tailles</div>
        <div data-t="p" class="opt"><i class="rd"></i>Une même largeur pour toutes les pages</div>
      </div>
      <div class="ft"><span class="b">Annuler</span><span class="b primary"><Icon name="FileUp" size={13} />Importer à ces tailles</span></div>
    </div>
  </div>
</Scaled>
</div>

<style>
  .dlg {
    width: 440px;
    height: 258px;
    font-size: 13px;
  }
  .hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .hd b {
    font-weight: 600;
    color: var(--ink);
  }
  .bd {
    padding: 16px;
    display: grid;
    gap: 16px;
  }
  .nm {
    font-weight: 500;
  }
  .sz {
    margin-top: 2px !important;
    color: var(--muted);
  }
  .lg {
    margin-bottom: 6px !important;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--muted);
  }
  .opt {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 6px;
  }
  .opt.on {
    background: var(--hover);
  }
  .rd {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid #777;
  }
  .rd.on {
    border: 4px solid var(--off);
  }
  .ft {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
