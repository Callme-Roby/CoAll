---
/** L'éditeur au complet : en-tête, Calques, outils, canvas, barre de demande, panneau Design. */
import Scaled from "../Scaled.astro";
import Editor from "./_a/Editor.astro";
import Row from "./_a/Row.astro";
import Tr from "./_a/Tr.astro";
import FramePanel from "./_a/FramePanel.astro";
import Frame from "./_kit/Frame.astro";
import Site from "./_a/Site.astro";
---
<Scaled w={1440} h={820} label="L'éditeur de Coall : l'en-tête en haut, le panneau Calques à gauche, le canvas et ses frames au centre avec la barre d'outils et la barre de demande, le panneau Design à droite.">
  <div class="q">
    <Editor prompt="Sur <b>Accueil</b>">
      <Fragment slot="left">
        <Row name="Accueil" sel />
        <Row name="Tarifs" />
        <Row name="Atelier" />
        <Row name="Contact" />
      </Fragment>
      <Fragment slot="tree">
        <Tr d={0} open icon="Square">Page</Tr>
        <Tr d={1} open={false}>En-tête</Tr>
        <Tr d={1} open>Hero</Tr>
        <Tr d={2} icon="Type">Titre</Tr>
        <Tr d={2} icon="Type">Texte</Tr>
        <Tr d={2} comp>Bouton</Tr>
        <Tr d={1} open={false} icon="Image">Image</Tr>
        <Tr d={1} open={false}>Collection</Tr>
      </Fragment>
      <Frame x={80} y={110} w={220} h={330} name="Accueil" selected play><Site scale={0.72} /></Frame>
      <Frame x={340} y={110} w={220} h={330} name="Tarifs"><Site page="tarifs" scale={0.72} /></Frame>
      <Frame x={600} y={110} w={220} h={330} name="Atelier"><Site page="atelier" scale={0.72} /></Frame>
      <Frame x={860} y={110} w={220} h={330} name="Contact"><Site page="contact" scale={0.72} /></Frame>
      <FramePanel slot="right" name="Accueil" x={0} y={0} w={1440} h={2310} />
    </Editor>
  </div>
</Scaled>
<style>
  .q {
    width: 100%;
    height: 100%;
  }
  .q :global(.kfr:not(.sel) .kt) {
    color: var(--muted);
  }
</style>
