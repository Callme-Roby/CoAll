---
/** Commentaire sur un élément (components/editor/Comments.tsx) : pastille, élément entouré de bleu, bulle du fil. */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
import Canvas from "./_kit/Canvas.astro";
import Frame from "./_kit/Frame.astro";
import Site from "./_kit/Site.astro";
---
<Scaled w={900} h={540} label="Une pastille aux initiales de l'auteur est posée sur le titre, entouré de bleu ; la bulle montre le fil, sa réponse, Résoudre et le champ Répondre.">
  <div class="tui-win cm">
    <Canvas>
      <Frame x={90} y={90} w={360} h={420} name="Accueil" kind="off">
        <div class="pgw"><Site scale={1.2} /></div>
      </Frame>
      <!-- Élément commenté (titre) -->
      <div class="target"></div>
      <!-- Pastille -->
      <span class="pin" style="background:#007b83">MD<span class="nb">2</span></span>

      <!-- Bulle -->
      <div class="bub">
        <div class="bh">
          <p class="tl"><b>Accueil</b> › « Des lampes qui suivent votre journée »</p>
          <span class="res"><Icon name="Check" size={13} />Résoudre</span>
          <span class="x"><Icon name="X" size={14} /></span>
        </div>
        <ol class="msgs">
          <li>
            <p class="mh"><span class="av" style="background:#007b83">MD</span><b>Marc Duval</b><time>il y a 12 minutes</time></p>
            <p class="mt">Le titre passe sur trois lignes en mobile. On peut le raccourcir ?</p>
          </li>
          <li>
            <p class="mh"><span class="av" style="background:#9334e6">AB</span><b>Alice Bernard</b><time>il y a 3 minutes</time></p>
            <p class="mt">Oui : « La lumière qui vous suit. » Je fais une hypothèse.</p>
          </li>
        </ol>
        <div class="cmp">
          <span class="av" style="background:#c25100">JM</span>
          <span class="ta">Répondre…</span>
          <span class="snd"><Icon name="ArrowUp" size={13} stroke={2.5} /></span>
        </div>
      </div>
    </Canvas>
  </div>
</Scaled>

<style>
  .cm {
    width: 900px;
    height: 540px;
    border-radius: 12px;
  }
  .pgw {
    height: 100%;
  }
  /* Le titre de la page (Site, échelle 1.2) : position mesurée sur la frame. */
  .target {
    position: absolute;
    left: 110px;
    top: 168px;
    width: 322px;
    height: 57px;
    border-radius: 2px;
    outline: 2px solid var(--off);
    background: rgba(13, 153, 255, 0.08);
    z-index: 2;
  }
  .pin {
    position: absolute;
    left: 432px;
    top: 140px;
    width: 28px;
    height: 28px;
    border-radius: 50% 50% 50% 3px;
    border: 2px solid #fff;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    display: grid;
    place-items: center;
    box-shadow:
      0 1px 4px rgba(0, 0, 0, 0.3),
      0 0 0 2px var(--off);
    transform: scale(1.1);
    transform-origin: 0 100%;
    z-index: 3;
  }
  .nb {
    position: absolute;
    top: -7px;
    right: -7px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 99px;
    border: 1px solid #fff;
    background: var(--ink);
    color: var(--panel);
    font-size: 9px;
    line-height: 14px;
    text-align: center;
  }
  .bub {
    position: absolute;
    left: 474px;
    top: 140px;
    width: 300px;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--panel);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
    z-index: 3;
  }
  .bh {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 6px 6px 12px;
    border-bottom: 1px solid var(--line);
  }
  .tl {
    flex: 1;
    min-width: 0;
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tl b {
    font-weight: 500;
    color: var(--ink);
  }
  .res {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 500;
    background: var(--hover);
  }
  .x {
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .msgs {
    list-style: none;
    margin: 0;
    padding: 4px 0;
  }
  .msgs li {
    padding: 8px 12px;
  }
  .mh {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mh b {
    font-weight: 600;
  }
  .mh time {
    font-size: 11px;
    color: var(--muted);
  }
  .av {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 9px;
    font-weight: 600;
  }
  .mt {
    margin-top: 4px !important;
    padding-left: 28px;
    line-height: 1.625;
  }
  .cmp {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 8px 12px;
    border-top: 1px solid var(--line);
  }
  .cmp .av {
    margin-bottom: 4px;
  }
  .ta {
    flex: 1;
    min-height: 28px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    line-height: 1.25;
  }
  .snd {
    flex: none;
    width: 24px;
    height: 24px;
    margin-bottom: 2px;
    border-radius: 50%;
    background: var(--off-strong);
    color: #fff;
    display: grid;
    place-items: center;
    opacity: 0.3;
  }
</style>
