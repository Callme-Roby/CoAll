---
/** Une section « Accueil » : l'écran et ses formats en ligne, du plus large au plus étroit (screens.ts). */
import Scaled from "../Scaled.astro";
import Canvas from "./_kit/Canvas.astro";
import Frame from "./_kit/Frame.astro";
import Site from "./_a/Site.astro";
import Section from "./_a/Section.astro";

// Zoom 25 % : 1440 → 360, 768 → 192, 390 → 98 ; écart 120 → 30 ; marges de section 80 → 20, en-tête 160 → 40.
const z = 0.25, X = 50, Y = 90;
const F = [
  { n: "Accueil", w: 1440, h: 1500, size: "desktop", s: 1.1 },
  { n: "Accueil · tablette", w: 768, h: 1900, size: "tablet", s: 0.62 },
  { n: "Accueil · mobile", w: 390, h: 2300, size: "mobile", s: 0.36 },
] as const;
let x = X + 80 * z;
const placed = F.map((f) => {
  const p = { ...f, x, w: f.w * z, h: f.h * z };
  x += f.w * z + 120 * z;
  return p;
});
const secW = x - 120 * z + 80 * z - X;
const secH = 160 * z + Math.max(...placed.map((p) => p.h)) + 80 * z;
---
<Scaled w={860} h={760} label="La section Accueil : en ligne, la frame ordinateur (1440 px), la frame Accueil · tablette (768 px) et la frame Accueil · mobile (390 px).">
  <div class="q">
    <Canvas>
      <Section x={X} y={Y} w={secW} h={secH} name="Accueil" />
      {placed.map((p) => (
        <Frame x={p.x} y={Y + 160 * z} w={p.w} h={p.h} name={p.n}><Site size={p.size} scale={p.s} /></Frame>
      ))}
    </Canvas>
  </div>
</Scaled>
<style>
  .q {
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .q :global(.kfr .kt) {
    color: var(--muted);
    overflow: hidden;
  }
  .q :global(.kfr .kt b) {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
