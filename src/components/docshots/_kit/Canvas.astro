---
/** Fond du canvas de Coall (grille de points), à placer dans un Scaled. Les enfants se positionnent en absolu. */
interface Props { class?: string; style?: string }
const { class: cls = "", style = "" } = Astro.props;
---
<div class={`kcv ${cls}`} style={style}><slot /></div>

<style>
  .kcv {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--canvas);
    background-image: radial-gradient(#333336 1px, transparent 1.3px);
    background-size: 24px 24px;
  }
</style>
