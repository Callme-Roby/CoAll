---
/** Panneau Design d'une frame officielle sélectionnée (components/editor/PropertiesPanel.tsx › FrameProperties + ExportBlock). */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
---
<Scaled w={320} h={600} label="Panneau Design de la frame officielle Accueil : nom, position X et Y, largeur et hauteur, boutons Créer une hypothèse, Dupliquer la frame et Archiver, statut et origine, puis Exporter.">
  <aside class="tui-win rp">
    <div class="tabs">
      <span class="tab on">Design</span><span class="tab">Timeline</span><span class="tab">Versions</span><span class="tab"><Icon name="MessageCircle" size={14} /></span>
      <span class="x"><Icon name="PanelRightClose" size={14} /></span>
    </div>
    <div class="st"><span>Frame</span></div>
    <div class="fields">
      <label class="f wide"><span>Nom</span><i class="in">Accueil</i></label>
      <div class="g2">
        <label class="f"><span>X</span><i class="in">0</i></label>
        <label class="f"><span>Y</span><i class="in">0</i></label>
        <label class="f"><span>L</span><i class="in">1440</i></label>
        <label class="f dis"><span>H</span><i class="in">3120</i></label>
      </div>
    </div>
    <div class="btns">
      <span class="b sm full hyp"><Icon name="GitBranch" size={13} />Créer une hypothèse</span>
      <span class="b sm full"><Icon name="Copy" size={13} />Dupliquer la frame</span>
      <span class="b sm full danger"><Icon name="Archive" size={13} />Archiver</span>
    </div>
    <div class="meta">
      <p>Statut : <b>Officielle</b></p>
      <p>Origine : import</p>
      <p class="help">Double-cliquez dans la frame pour sélectionner ses éléments. Les frames archivées ne sont jamais supprimées.</p>
    </div>
    <div class="exp">
      <div class="st"><span>Exporter</span></div>
      <div class="px"><span class="b sm full"><Icon name="Download" size={13} />PNG, PDF, HTML/CSS…</span></div>
    </div>
  </aside>
</Scaled>

<style>
  .rp {
    width: 320px;
    height: 600px;
    border-radius: 10px;
  }
  .tabs {
    gap: 2px;
  }
  .tab {
    padding: 0 6px;
  }
  .x {
    margin-left: auto;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .fields {
    padding: 0 12px;
    display: grid;
    gap: 8px;
  }
  .g2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .f {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .f > span {
    width: 36px;
    flex: none;
    color: var(--muted);
  }
  .f.wide > span {
    width: 64px;
  }
  .f i {
    flex: 1;
    font-style: normal;
  }
  .f.dis i {
    opacity: 0.4;
  }
  .btns {
    margin-top: 12px;
    padding: 0 12px;
    display: grid;
    gap: 6px;
  }
  .b.sm {
    font-size: 11px;
  }
  .b.hyp {
    border-color: color-mix(in srgb, var(--hyp) 40%, transparent);
    color: var(--hyp-ink);
  }
  .meta {
    margin-top: 16px;
    border-top: 1px solid var(--line);
    padding: 12px 12px 0;
    display: grid;
    gap: 4px;
    color: var(--muted);
  }
  .meta b {
    font-weight: 500;
    color: var(--ink);
  }
  .help {
    padding-top: 8px;
    line-height: 1.6;
  }
  .exp {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  .px {
    padding: 0 12px;
  }
</style>
