---
/** Page Skills et règles (app/(home)/skills/page.tsx, components/home/SkillsLibrary.tsx), onglet Skills. */
import Scaled from "../Scaled.astro";
import Icon from "../Icon.astro";
import HomeShell from "./_d/HomeShell.astro";
const skills = [
  { name: "charte-lumen", desc: "Appliquer la charte de Lumen : couleurs, polices, arrondis.", files: "tokens.json", to: "2 projets", open: true },
  { name: "mobile-d-abord", desc: "Concevoir chaque écran en mobile (390 px) avant la tablette et l'ordinateur.", files: "", to: "Tous mes projets" },
  { name: "composants-maison", desc: "Réutiliser nos boutons, cartes et champs avant d'en créer de nouveaux.", files: "", to: "1 projet" },
];
const projects: [string, boolean][] = [
  ["Lumen · Site vitrine", true],
  ["Lumen · Boutique", true],
  ["Studio Yoga · Application", false],
  ["Refonte des tarifs", false],
];
---
<Scaled w={1200} h={770} label="Page Skills et règles, onglet Skills : la bibliothèque de skills, le bouton Ajouter un skill et, pour chaque skill, le choix des projets auxquels il s'applique.">
  <HomeShell active="Skills et règles" title="Skills et règles" desc="Orientez l’IA dans vos projets. Vos skills et vos règles s’appliquent à toutes les demandes des projets dont vous êtes l’hôte, celles de vos invités comprises. Une demande explicite passe devant : l’IA la suit et le signale.">
    <div class="tabsk"><i class="on">Skills (3)</i><i>Règles (4)</i></div>
    <div class="intro">
      <div data-t="p">Un skill apprend à l’IA une façon de faire : votre charte graphique, toujours concevoir en mobile d’abord, vos composants maison… Format des skills de Claude : un dossier avec un fichier SKILL.md.</div>
      <span class="b primary"><Icon name="Plus" size={14} />Ajouter un skill</span>
    </div>
    <div class="list">
      {skills.map((s) => (
        <article class="sk">
          <div class="top">
            <span class="spk"><Icon name="Sparkles" size={16} /></span>
            <div class="txt">
              <div data-t="h4">{s.name}</div>
              <div data-t="p">{s.desc}</div>
              {s.files && <div data-t="p" class="fj">Fichiers joints : {s.files}</div>}
            </div>
            <div class="to">
              <span class="tob">{s.to}<Icon name="ChevronDown" size={12} /></span>
              {s.open && (
                <div class="menu">
                  <div data-t="p" class="all"><i class="cb"></i>Tous mes projets (et les prochains)</div>
                  <div data-t="hr"></div>
                  {projects.map(([n, on]) => <div data-t="p"><i class:list={["cb", { on }]}>{on && <Icon name="Check" size={9} stroke={3} />}</i>{n}</div>)}
                </div>
              )}
            </div>
          </div>
          <div class="btns"><span class="b sm ghost">Voir et modifier</span><span class="b sm ghost">Retirer</span></div>
        </article>
      ))}
    </div>
  </HomeShell>
</Scaled>

<style>
  .tabsk {
    display: flex;
    width: fit-content;
    padding: 2px;
    border-radius: 8px;
    background: var(--hover);
    font-size: 13px;
    margin-bottom: 20px;
  }
  .tabsk i {
    font-style: normal;
    height: 32px;
    line-height: 32px;
    padding: 0 16px;
    border-radius: 6px;
    font-weight: 500;
    color: var(--muted);
  }
  .tabsk i.on {
    background: var(--panel);
    color: var(--ink);
  }
  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .intro [data-t="p"] {
    max-width: 640px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }
  .list {
    display: grid;
    gap: 12px;
  }
  .sk {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    padding: 16px;
  }
  .top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .spk {
    color: var(--ai);
    margin-top: 2px;
  }
  .txt {
    flex: 1;
    min-width: 0;
  }
  [data-t="h4"] {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }
  .txt [data-t="p"] {
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }
  .txt .fj {
    font-size: 11px;
    margin-top: 4px;
  }
  .to {
    position: relative;
  }
  .tob {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
  }
  .menu {
    position: absolute;
    right: 0;
    top: 32px;
    z-index: 3;
    width: 256px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.7);
    font-size: 12px;
  }
  .menu [data-t="p"] {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border-radius: 4px;
  }
  .menu .all {
    font-weight: 500;
  }
  .menu [data-t="hr"] {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 4px 0;
  }
  .cb {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    border: 1px solid #777;
    display: grid;
    place-items: center;
    flex: none;
  }
  .cb.on {
    background: var(--off-strong);
    border-color: var(--off-strong);
    color: #fff;
  }
  .btns {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
</style>
