---
/** Icône Lucide (la même bibliothèque que l'outil), rendue en SVG inline. */
import * as icons from "lucide-static";
interface Props { name: string; size?: number; stroke?: number; class?: string }
const { name, size = 16, stroke = 2, class: cls = "" } = Astro.props;
const raw = (icons as Record<string, string>)[name] ?? "";
if (!raw) console.warn(`Icône Lucide inconnue : ${name}`);
const svg = raw
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace(/class="([^"]*)"/, `class="$1 ${cls}" aria-hidden="true"`);
---
<Fragment set:html={svg} />
