---
interface Props { eyebrow: string; title: string; lead?: string; color?: string }
const { eyebrow, title, lead } = Astro.props;
---
<header class="ph">
  <div class="wrap ph-inner">
    <span class="label">{eyebrow}</span>
    <h1 class="h1" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph {
    position: relative;
    padding: clamp(72px, 10vw, 136px) 0 clamp(56px, 7vw, 96px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .ph-inner {
    position: relative;
    display: grid;
    gap: 22px;
    justify-items: start;
    max-width: 860px;
  }
  .ph-inner :global(.lead) {
    max-width: 680px;
  }
</style>
