          <span class="tl"><Icon name="Hand" /></span>
          <span class="tl"><Icon name="Frame" /></span>
          <span class="tl"><Icon name="SquareDashed" /></span>
          <span class="tl"><Icon name="MessageCircle" /></span>
        </div>

        <!-- Indicateur d'écoute + ce que l'IA a compris -->
