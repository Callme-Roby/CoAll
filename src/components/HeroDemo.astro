---
/**
 * Démo du hero : une réunion dans Coall, rejouée en boucle, au plus près de l'éditeur réel (thème sombre).
 * Mise en page, tailles, couleurs, libellés et icônes relevés dans apps/web/components/{editor,call}
 * du dépôt co-design : en-tête 44 px, panneau Calques 240 px, panneau de droite 320 px,
 * panneau d'appel 264 px, grille de points 24 px, barre de demande, badge de l'IA, propositions.
 */
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";

// Couleurs d'utilisateur de l'outil (lib/identity).
const P = {
  jean: { name: "Jean Morel", first: "Jean", ini: "JM", color: "#c25100" },
  alice: { name: "Alice Bernard", first: "Alice", ini: "AB", color: "#9334e6" },
  marc: { name: "Marc Duval", first: "Marc", ini: "MD", color: "#007b83" },
};
const people = [P.jean, P.alice, P.marc];
const arrow = (c: string) =>
  `<svg width="18" height="18" viewBox="0 0 18 18"><path d="M2 1.5 L15.5 8.2 L9.2 9.6 L6.4 15.8 Z" fill="${c}" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg>`;
---

<div class="demo" data-demo role="img" aria-label="Démonstration : pendant un appel dans Coall, une phrase devient une hypothèse sur le canvas, l'équipe la compare puis la valide.">
  <div class="demo-frame" data-frame>
    <div class="stage" data-stage data-step="0">
      <!-- ========== En-tête ========== -->
      <header class="tb">
        <span class="tb-back"><Icon name="ChevronLeft" size={14} />Projets</span>
        <i class="tb-div"></i>
        <span class="tb-name">Lumen · Site vitrine</span>
        <span class="tb-tools">
          <span class="ib"><Icon name="SquarePlus" /></span>
          <span class="ib"><Icon name="FileUp" /></span>
          <span class="ib"><Icon name="Download" /></span>
          <span class="ib"><Icon name="Search" /></span>
          <i class="tb-div"></i>
          <span class="ib off"><Icon name="Undo2" /></span>
          <span class="ib off"><Icon name="Redo2" /></span>
        </span>
        <span class="tb-right">
          <span class="ib"><Icon name="Minus" size={14} /></span>
          <span class="tb-zoom">62 %</span>
          <span class="ib"><Icon name="Plus" size={14} /></span>
          <span class="ib"><Icon name="Maximize" size={14} /></span>
          <i class="tb-div"></i>
          <span class="avs">
            {people.map((p) => (
              <span class="av" style={`background:${p.color}`}>{p.ini}<span class="incall"><Icon name="Video" size={8} /></span></span>
            ))}
          </span>
          <span class="tb-invite"><Icon name="UserPlus" size={14} />Inviter</span>
        </span>
      </header>

      <!-- ========== Panneau gauche : Calques ========== -->
      <aside class="lp">
        <div class="tabs">
          <span class="tab on">Calques</span><span class="tab">Ressources</span>
          <span class="tab-x"><Icon name="PanelLeftClose" size={14} /></span>
        </div>
        <div class="st"><span>Frames</span><label class="arch"><i></i>Archives</label></div>
        <div class="search"><Icon name="Search" size={12} /><span>Rechercher dans les calques</span></div>
        <div class="rows">
          <div class="row r-off" data-row-off><span class="ri off"><Icon name="Frame" size={13} /></span><span>Accueil</span></div>
          <div class="row r-hyp" data-row-hyp><span class="ri hyp"><Icon name="Frame" size={13} /></span><span>Accueil</span><span class="lbl">Version Jean</span></div>
          <div class="row"><span class="ri off"><Icon name="Frame" size={13} /></span><span>Tarifs</span></div>
          <div class="row"><span class="ri off"><Icon name="Frame" size={13} /></span><span>Atelier</span></div>
        </div>
        <div class="tree">
          <div class="st"><span>Calques</span></div>
          <div class="tr" style="--d:0"><Icon name="ChevronDown" size={12} /><Icon name="Square" size={12} />Page</div>
          <div class="tr" style="--d:1"><Icon name="ChevronRight" size={12} /><Icon name="Square" size={12} />En-tête</div>
          <div class="tr" style="--d:1"><Icon name="ChevronDown" size={12} /><Icon name="Square" size={12} />Hero</div>
          <div class="tr sel" style="--d:2"><span class="sp"></span><Icon name="Type" size={12} />Titre</div>
          <div class="tr" style="--d:2"><span class="sp"></span><Icon name="Type" size={12} />Texte</div>
