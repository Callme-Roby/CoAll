          <span class="lpill"><span class="ldot"></span>L'IA écoute<span class="lpause">Pause</span></span>
          <span class="lstatus" data-status></span>
        </div>

        <!-- Frame officielle -->
        <div class="fr f-off" data-off>
          <div class="ftitle"><b>Accueil</b><span class="chip-arch">Archivée</span></div>
          <span class="play"><Icon name="Play" size={10} /></span>
          <div class="fbody">
            <div class="scan"></div>
            <div class="site">
              <div class="s-nav"><b>Lumen</b><span>Collection</span><span>Atelier</span><span>Tarifs</span></div>
